msgstr "O que aconteceu neste site, do mais novo para o mais antigo. Mostra só o que estava sendo registrado na hora: um grupo marcado hoje de manhã não tem nada de ontem."

#: includes/admin-log.php:611
#: includes/admin-log.php:694
#: includes/log-privacy.php:80
msgid "What happened"
msgstr "O que aconteceu"

#: includes/admin-log.php:613
msgid "Anything that happened"
msgstr "Qualquer coisa que tenha acontecido"

#: includes/admin-log.php:627
#: includes/admin-log.php:691
