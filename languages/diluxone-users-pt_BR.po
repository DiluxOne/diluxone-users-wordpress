#. translators: 1: sections shown, 2: sections there are
#, php-format
msgid "%1$d of %2$d shown."
msgstr "%1$d de %2$d exibidos."

#. translators: 1: how long ago, 2: device and browser, 3: IP address
#, php-format
msgid "%1$s ago, from %2$s (%3$s)"
msgstr "há %1$s, de %2$s (%3$s)"

#. translators: 1: the address, 2: what else is there
#, php-format
msgid "%1$s is also %2$s, which nobody can reach while the sign-in page answers there."
msgstr "%1$s também é o endereço de %2$s, que ninguém consegue acessar enquanto a página de acesso responder ali."

#. translators: 1: how many people, 2: how many accounts in total
#, php-format
msgid "%1$s of %2$s"
msgstr "%1$s de %2$s"

#. translators: 1: number of people, 2: current page, 3: total pages
#, php-format
msgid "%1$s people with an open session · page %2$d of %3$d"
msgstr "%1$s pessoas com sessão aberta · página %2$d de %3$d"

#. translators: 1: number of rows, 2: current page, 3: total pages
#, php-format
msgid "%1$s rows · page %2$d of %3$d"
msgstr "%1$s linhas · página %2$d de %3$d"

#. translators: 1: how long with "remember me" (a number of days, or what WordPress decides), 2: the same without it
#, php-format
msgid "%1$s with “remember me”, %2$s without. The e-mail link always counts as “remember me”."
msgstr "%1$s com “lembrar de mim”, %2$s sem. O link por e-mail sempre conta como “lembrar de mim”."

#. translators: 1: plugin name, 2: screen name
#, php-format
msgctxt "title of a dashboard screen"
msgid "%1$s | %2$s"
msgstr "%1$s | %2$s"

#. translators: 1: percentage done, 2: additions looked at, 3: additions in all
#, php-format
msgid "%1$s%% (%2$s of %3$s)"
msgstr "%1$s%% (%2$s de %3$s)"

#. translators: 1: provider name, 2: how it stands, in a sentence
#, php-format
msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

#. translators: %d: number of providers
#, php-format
msgid "%d provider configured and enabled."
msgid_plural "%d providers configured and enabled."
msgstr[0] "%d provedor configurado e ativado."
msgstr[1] "%d provedores configurados e ativados."

#. translators: %d: how many refused sign-in attempts are kept.
#, php-format
msgid "%d refused sign-in attempt that typed this person's username or e-mail was kept: it is security evidence, and it is deleted when the activity log's retention runs out."
msgid_plural "%d refused sign-in attempts that typed this person's username or e-mail were kept: they are security evidence, and they are deleted when the activity log's retention runs out."
msgstr[0] "%d tentativa de entrada recusada que digitou o usuário ou o e-mail desta pessoa foi mantida: é evidência de segurança, e é apagada quando vence a retenção do registro de atividade."
msgstr[1] "%d tentativas de entrada recusadas que digitaram o usuário ou o e-mail desta pessoa foram mantidas: são evidência de segurança, e são apagadas quando vence a retenção do registro de atividade."

#. translators: %d: number of settings written
#, php-format
msgid "%d setting restored."
msgid_plural "%d settings restored."
msgstr[0] "%d configuração restaurada."
msgstr[1] "%d configurações restauradas."

#. translators: %d: number of failing checks
#, php-format
msgid "%d thing needs attention."
msgid_plural "%d things need attention."
msgstr[0] "%d coisa precisa de atenção."
msgstr[1] "%d coisas precisam de atenção."

#. translators: %d: how many times it can be changed
#, php-format
msgid "%d time"
msgid_plural "%d times"
msgstr[0] "%d vez"
msgstr[1] "%d vezes"

#. translators: %s: how many sessions were closed at once.
#, php-format
msgid "%s closed"
msgstr "%s fechadas"

#. translators: %s: a number of days
#, php-format
msgid "%s day"
msgid_plural "%s days"
msgstr[0] "%s dia"
msgstr[1] "%s dias"

#. translators: %s: one or more placeholders, e.g. {link}
#, php-format
msgid "%s has to stay in whatever you write: without it the message is a dead end, so a save that lost it is refused."
msgstr "%s precisa continuar no que você escrever: sem ele a mensagem é um beco sem saída, então um salvamento que o perdeu é recusado."

#. translators: %s: the ways in that are never behind a tab, comma separated
#, php-format
msgid "%s is not in this list and never goes behind a tab: it is the fastest way in there is, a tab would cost it a click, and inside one the browser never gets to offer it as the address field is focused."
msgstr "%s não está nesta lista e nunca vai atrás de uma aba: é a forma de entrar mais rápida que existe, uma aba custaria um clique a ela, e dentro de uma o navegador nunca chega a oferecê-la porque o foco está no campo do endereço."

#. translators: %s: number of jobs
#, php-format
msgid "%s job is adding people in the background."
msgid_plural "%s jobs are adding people in the background."
msgstr[0] "%s tarefa está adicionando pessoas em segundo plano."
msgstr[1] "%s tarefas estão adicionando pessoas em segundo plano."

#. translators: %s: number of sites
#, php-format
msgid "%s live site."
msgid_plural "%s live sites."
msgstr[0] "%s site ativo."
msgstr[1] "%s sites ativos."

#. translators: %s: how many people have a session open
#, php-format
msgid "%s person has a session open."
msgid_plural "%s people have a session open."
msgstr[0] "%s pessoa tem uma sessão aberta."
msgstr[1] "%s pessoas têm uma sessão aberta."

#. translators: %s: number of sites
#, php-format
msgid "%s site on this network."
msgid_plural "%s sites on this network."
msgstr[0] "%s site nesta rede."
msgstr[1] "%s sites nesta rede."

#. translators: %s: how many suggested fields are not on the list
#, php-format
msgid "%s suggested field is not on the list."
msgid_plural "%s suggested fields are not on the list."
msgstr[0] "%s campo sugerido não está na lista."
msgstr[1] "%s campos sugeridos não estão na lista."

#. translators: %s: a percentage, already rounded
#, php-format
msgid "%s%%"
msgstr "%s%%"

#. translators: %s: a role's name
#, php-format
msgid "%s, whichever door they came through."
msgstr "%s, seja qual for a porta por onde a pessoa chegou."

#. translators: Accessibility text.
msgid "(opens in a new tab)"
msgstr "(abre em uma aba nova)"

msgid "0 for what WordPress decides, 14 days. The sign-in link always counts as “remember me”: there is no password to type again."
msgstr "0 para o que o WordPress decidir, 14 dias. O link de acesso sempre conta como “lembrar de mim”: não há senha para digitar de novo."

msgid "0 for what WordPress decides, 2 days. What somebody gets when they leave the box unticked on a form that offers it."
msgstr "0 para o que o WordPress decidir, 2 dias. O que recebe quem deixa a caixa desmarcada num formulário que a oferece."

msgid "2FA"
msgstr "2FA"

msgid "A bar down the left"
msgstr "Uma barra à esquerda"

msgid "A bit more about you"
msgstr "Um pouco mais sobre você"

msgid "A border and the text in the accent, on the page’s own ground. For a design where a block of colour would be too loud."
msgstr "Uma borda e o texto na cor de destaque, sobre o fundo da própria página. Para um design em que um bloco de cor seria demais."

msgid "A box under Security in their account area, with one line per device. Unticked, the box is not there and closing a session stays an administrator’s job, from the report of open sessions."
msgstr "Um quadro em Segurança na área de conta dela, com uma linha por dispositivo. Sem marcar, o quadro não está lá e fechar uma sessão continua sendo tarefa de quem administra, a partir do relatório de sessões abertas."

msgid "A brand new project needs no API enabled: sign-in works with the OAuth client alone. What does stop it is leaving the app in “Testing” and forgetting to add the person as a test user — they get “access blocked”."
msgstr "Um projeto novo não precisa habilitar nenhuma API: o acesso funciona só com o cliente OAuth. O que trava mesmo é deixar o aplicativo em “Teste” e esquecer de adicionar a pessoa como usuário de teste: aparece “acesso bloqueado”."

msgid "A button takes the colours the theme gives its own buttons, or yours."
msgstr "Um botão usa as cores que o tema dá aos próprios botões, ou as suas."

msgid "A button to their details"
msgstr "Um botão para os dados dela"

msgid "A centred card"
msgstr "Um cartão centralizado"

msgid "A change in their security"
msgstr "Uma mudança na segurança dela"

msgid "A class, as <code>.is-dark</code>, or an attribute, as <code>data-theme=\"dark\"</code>, or <code>data-mode</code> with any value."
msgstr "Uma classe, como <code>.is-dark</code>, ou um atributo, como <code>data-theme=\"dark\"</code>, ou <code>data-mode</code> com qualquer valor."

msgid "A code by email"
msgstr "Um código por e-mail"

msgid "A code is on its way"
msgstr "Um código está a caminho"

msgid "A colour of its own"
msgstr "Uma cor própria"

msgid "A colour of “Sign in” was not a colour, so it keeps the one it had."
msgstr "Uma cor de “Entrar” não era uma cor, então fica a que já tinha."

msgid "A current code, to confirm it is you"
msgstr "Um código atual, para confirmar que é você"

#. translators: %s: provider name
#, php-format
msgid "A direct link to sign in with %s, if you want it somewhere else"
msgstr "Um link direto para entrar com %s, se você quiser em outro lugar"

msgid "A door in the site’s own menu: “Sign in” for visitors, and for whoever is signed in their photo or their name, with their account, the dashboard if they can use it, and a way out underneath. The theme draws it like the rest of the menu."
msgstr "Uma porta no próprio menu do site: “Entrar” para quem visita e, para quem entrou, sua foto ou seu nome, com a conta, o painel se puder usá-lo e uma forma de sair embaixo. O tema desenha como o resto do menu."

msgid "A few questions many sites ask the people who register. None of them is asked until it is added here: tick the ones this site needs and they join the list, where each can be edited, made required, moved or deleted like any other field."
msgstr "Algumas perguntas que muitos sites fazem a quem se cadastra. Nenhuma é feita até ser adicionada aqui: marque as que este site precisa e elas entram na lista, onde cada uma pode ser editada, tornada obrigatória, movida ou excluída como qualquer outro campo."

msgid "A few rows per person per day: this is the group that grows with how often people come back."
msgstr "Algumas linhas por pessoa por dia: este é o grupo que cresce com a frequência com que as pessoas voltam."

msgid "A field needs a name."
msgstr "Um campo precisa de um nome."

msgid "A file with everything this site keeps about you: your details, and what the site and its plugins record about you. You get an email to confirm; once you do, we prepare it and it shows up here to download."
msgstr "Um arquivo com tudo o que este site guarda sobre você: os seus dados, e o que o site e os plugins dele registram sobre você. Chega um e-mail para confirmar; quando você confirma, a gente prepara e ele aparece aqui para baixar."

msgid "A filled button"
msgstr "Um botão preenchido"

msgid "A filled button, a link, the section of the menu somebody is reading, and the initials drawn for anybody with no photo. Everything else — the grounds, the lines, the quiet text — the plugin builds around it. Each of these reads under white letters and as a link on white."
msgstr "Um botão preenchido, um link, a seção do menu que alguém está lendo e as iniciais desenhadas para quem não tem foto. Todo o resto — os fundos, as linhas, o texto discreto — o plugin constrói ao redor. Cada uma destas cores se lê sob letras brancas e como link sobre branco."

msgid "A form with every field on it, for whoever is signed in to fill in and save. Somebody who is not signed in sees nothing at all in its place."
msgstr "Um formulário com todos os campos, para quem tiver entrado preencher e salvar. Quem não tiver entrado não vê absolutamente nada no lugar dele."

#. translators: %s: e-mail address
#, php-format
msgid "A fresh code is on its way to %s."
msgstr "Um código novo está a caminho de %s."

msgid "A fresh install records nothing, and has no table to record it in until a group is ticked here. Each one is ticked by whoever will be paying for the rows — which is why each one says roughly what it costs."
msgstr "Uma instalação nova não registra nada, e não tem tabela onde registrar até que um grupo seja marcado aqui. Cada um é marcado por quem vai pagar pelas linhas — por isso cada um diz mais ou menos quanto custa."

msgid "A grid with every section visible"
msgstr "Uma grade com todas as seções à vista"

msgid "A line under the open section. Down the side it becomes a bar down the left, because a line under a stacked item runs across the whole menu."
msgstr "Uma linha sob a seção aberta. Na lateral vira uma barra à esquerda, porque uma linha sob um item empilhado atravessa o menu inteiro."

msgid "A link e-mailed to the address on the account"
msgstr "Um link por e-mail para o endereço da conta"

msgid "A link lets in only somebody who already has an account."
msgstr "Um link deixa entrar só quem já tem uma conta."

msgid "A link, like the rest of the menu"
msgstr "Um link, como o resto do menu"

msgid "A menu down the side"
msgstr "Um menu na lateral"

#. translators: %s: the e-mail address of a new account
#, php-format
msgid "A new account, %s, on every site"
msgstr "Uma conta nova, %s, em todos os sites"

msgid "A new password signs the account out on every other device, as WordPress does, and the list forgets them."
msgstr "Uma nova senha desconecta a conta em todos os outros dispositivos, como o WordPress faz, e a lista os esquece."

msgid "A page of its own"
msgstr "Uma página própria"

#. translators: %s: the address of the sign-in page
#, php-format
msgid "A page of its own, at %s."
msgstr "Uma página própria, em %s."

msgid "A panel in the page, the way a settings screen looks. It sits quietly inside whatever the theme already draws."
msgstr "Um painel dentro da página, do jeito que uma tela de configurações se parece. Fica quieta dentro do que o tema já desenha."

msgid "A phone number of the wrong length"
msgstr "Um telefone com o número de dígitos errado"

msgid "A registration form of the site’s own"
msgstr "Um formulário de cadastro do próprio site"

msgid "A screen of its own at an address you choose, with your mark and colours and none of the theme’s header or footer. No page to create."
msgstr "Uma tela própria num endereço que você escolhe, com sua marca e suas cores e sem o cabeçalho nem o rodapé do tema. Nenhuma página para criar."

msgid "A screen that comes back from a refused attempt ignores this and shows the way in that was refused, whatever it says here: a message about an address, read over a password form, explains nothing."
msgstr "Uma tela que volta de uma tentativa recusada ignora isto e mostra a forma de entrar que foi recusada, diga o que disser aqui: uma mensagem sobre um endereço, lida em cima de um formulário de senha, não explica nada."

msgid "A second step is asked, as set on Security."
msgstr "Uma segunda etapa é pedida, como definido em Segurança."

msgid "A secret is saved. Leave this empty to keep it, or paste a new one to replace it."
msgstr "Há um segredo salvo. Deixe isto vazio para mantê-lo, ou cole um novo para substituí-lo."

msgid "A session is what keeps somebody signed in after they close the tab. Here is how long one lasts on this site, and whether each person can see their own."
msgstr "Uma sessão é o que mantém alguém conectado depois de fechar a aba. Aqui está quanto tempo uma dura neste site, e se cada pessoa pode ver as suas."

msgid "A sign-in from a new device"
msgstr "Uma entrada de um dispositivo novo"

#. translators: %d: minutes
#, php-format
msgid "A single-use link, good for %d minutes."
msgstr "Um link de uso único, válido por %d minutos."

msgid "A social account"
msgstr "Uma conta social"

msgid "A social account lets in only somebody who already has one here."
msgstr "Uma conta social deixa entrar só quem já tem uma aqui."

msgid "A social account only signs in people who already have one here."
msgstr "Uma conta social só faz entrar quem já tem uma aqui."

msgid "A soft box in the colour of what it says"
msgstr "Uma caixa suave na cor do que ela diz"

msgid "A spacing of the menu was not a length in px or rem, so it keeps the one it had."
msgstr "Um espaçamento do menu não era uma medida em px ou rem, então fica o que já tinha."

#. translators: %s: e-mail address
#, php-format
msgid "A test message is on its way to %s. If it does not arrive, nothing else will either."
msgstr "Um e-mail de teste está a caminho de %s. Se não chegar, nada mais vai chegar."

msgid "A username and a password"
msgstr "Um nome de usuário e uma senha"

msgid "A web address cannot have spaces, so one of the two has to happen. The first is what almost everybody expects; the second is for a site that would rather nobody ends up with a name they did not type."
msgstr "Um endereço da web não pode ter espaços, então uma das duas coisas tem que acontecer. A primeira é o que quase todo mundo espera; a segunda é para um site que prefere que ninguém fique com um nome que não digitou."

#. translators: %s: provider name
#, php-format
msgid "A window opens, %s asks you to authorise, and it comes back here. Nobody is signed in and nothing is saved to your account — it only checks that the round trip works. Until it does, the button cannot be enabled."
msgstr "Uma janela se abre, o %s pede autorização, e volta para cá. Ninguém entra e nada é salvo na sua conta — só se verifica que o ida e volta funciona. Enquanto não funcionar, o botão não pode ser ativado."

msgid "A word between square brackets, typed into a page. Nobody visiting the site ever sees the brackets: while the page is being drawn, WordPress swaps the line for the real thing — a form, a list, a set of buttons. Put it twice and the thing appears twice; delete the line and it is gone. Nothing else on the page is affected."
msgstr "Uma palavra entre colchetes, escrita dentro de uma página. Ninguém que visita o site vê os colchetes: enquanto a página é desenhada, o WordPress troca a linha pela coisa de verdade — um formulário, uma lista, um conjunto de botões. Ponha duas vezes e a coisa aparece duas vezes; apague a linha e ela some. Nada mais na página é afetado."

msgid "About"
msgstr "Sobre"

msgid "About you"
msgstr "Sobre você"

msgid "Above all of them, always"
msgstr "Acima de todas, sempre"

msgid "Above and below"
msgstr "Acima e abaixo"

msgid "Accent"
msgstr "Destaque"

msgid "Accent colour"
msgstr "Cor de destaque"

msgid "Access"
msgstr "Acesso"

msgid "Access › Summary →"
msgstr "Acesso › Resumo →"

msgid "Access › The sign-in page →"
msgstr "Acesso › A página de acesso →"

msgid "Access →"
msgstr "Acesso →"

msgid "Account area"
msgstr "Área de conta"

msgid "Account details and sign-in methods"
msgstr "Dados da conta e formas de entrar"

msgid "Account linked."
msgstr "Conta vinculada."

msgid "Account page"
msgstr "Página da conta"

msgid "Account sections"
msgstr "Seções da conta"

msgid "Accounts"
msgstr "Contas"

#. translators: %s: the name of the site where the network's accounts live
#, php-format
msgid "Accounts are created on %s, for every site of the network. You come back here afterwards."
msgstr "As contas são criadas em %s, para todos os sites da rede. Depois você volta para cá."

msgid "Accounts are made by whoever administers the site, under Users. Every door below is shut, WordPress’s own form on Settings → General included."
msgstr "As contas são criadas por quem administra o site, em Usuários. Todas as portas abaixo estão fechadas, incluindo o formulário do próprio WordPress em Configurações → Geral."

msgid "Across the top, where the row begins, sits in the middle or ends. Down the side it is where the words in each line begin, which is the same question asked of a column."
msgstr "Em cima, onde a fila começa, fica no meio ou termina. Na lateral é onde começam as palavras de cada linha, que é a mesma pergunta feita a uma coluna."

msgid "Actions"
msgstr "Ações"

msgid "Activate DiluxOne Users+ for the whole network"
msgstr "Ativar o DiluxOne Users+ para a rede toda"

msgid "Active"
msgstr "Ativo"

msgid "Active: it shows up in the forms"
msgstr "Ativo: aparece nos formulários"

msgid "Activity"
msgstr "Atividade"

msgid "Activity log"
msgstr "Registro de atividade"

msgid "Add a block and pick the one called “Shortcode”. Typing “shortcode” into the block search finds it."
msgstr "Adicione um bloco e escolha o que se chama «Shortcode». Digitando «shortcode» na busca de blocos ele aparece."

msgid "Add a section"
msgstr "Adicionar uma seção"

msgid "Add field"
msgstr "Adicionar campo"

msgid "Add one and from then on it opens this account too. Nothing gets duplicated: it is the same account with another way in."
msgstr "Adicione uma e a partir daí ela também abre esta conta. Nada é duplicado: é a mesma conta com outra forma de entrar."

msgid "Add suggested fields"
msgstr "Adicionar campos sugeridos"

msgid "Add the ones ticked"
msgstr "Adicionar os marcados"

msgid "Added by something else on this site"
msgstr "Adicionado por outra coisa neste site"

msgid "Adding everybody to every site has started. It goes on in the background, a batch at a time; its progress is below."
msgstr "Começou a adição de todos em todos os sites. Continua em segundo plano, um lote de cada vez; o progresso está abaixo."

msgid "Additional details"
msgstr "Dados adicionais"

msgid "Address"
msgstr "Endereço"

msgid "Afghanistan"
msgstr "Afeganistão"

msgid "After sign-in"
msgstr "Depois de entrar"

msgid "After signing in, ask for the required fields the account has no answer for"
msgstr "Depois de entrar, pedir os campos obrigatórios que a conta não preencheu"

msgid "After signing in, people go straight to where they were going, whatever their account is missing."
msgstr "Depois de entrar, as pessoas vão direto para onde iam, falte o que faltar na conta."

msgid "After the door"
msgstr "Depois da porta"

msgid "After the link is sent"
msgstr "Depois que o link é enviado"

msgid "After what the plugin shows"
msgstr "Depois do que o plugin mostra"

msgid "Aland Islands"
msgstr "Ilhas Aland"

msgid "Albania"
msgstr "Albânia"

msgid "Algeria"
msgstr "Argélia"

msgid "All the doors"
msgstr "Todas as portas"

msgid "Almost nothing, and it is the group worth having when an account is taken over."
msgstr "Quase nada, e é o grupo que vale a pena ter quando uma conta é invadida."

msgid "Almost nothing: most people change these once and never again."
msgstr "Quase nada: a maioria muda isso uma vez e nunca mais."

msgid "Already have an account?"
msgstr "Já tem uma conta?"

msgid "Always in tabs"
msgstr "Sempre em abas"

msgid "Always sent"
msgstr "Sempre enviado"

msgid "Always sent — no switch for anybody"
msgstr "Sempre enviado — sem interruptor para ninguém"

msgid "Always stacked"
msgstr "Sempre empilhadas"

msgid "American Samoa"
msgstr "Samoa Americana"

msgid "An account belongs to the whole network; being a member of a site — having a role on it — is each site’s. This decides which sites an account is a member of, for every site of the network."
msgstr "Uma conta pertence à rede inteira; ser membro de um site — ter uma função nele — é coisa de cada site. Isto decide de quais sites uma conta é membro, para todos os sites da rede."

msgid "An account with admin permissions cannot ask for its own deletion."
msgstr "Uma conta com permissões de administração não pode pedir a própria exclusão."

msgid "An address the site has never seen gets a link, and the account exists by the time they are in."
msgstr "Um endereço que o site nunca viu recebe um link, e a conta existe quando a pessoa entra."

msgid "An authenticator app"
msgstr "Um aplicativo autenticador"

msgid "An icon inside the buttons of the doors: an envelope on the link"
msgstr "Um ícone dentro dos botões das portas: um envelope no link"

msgid "An outlined button"
msgstr "Um botão com contorno"

msgid "And again"
msgstr "E de novo"

msgid "And the note under it"
msgstr "E a nota abaixo"

msgid "And then, here"
msgstr "E depois, aqui"

msgid "Andorra"
msgstr "Andorra"

msgid "Angola"
msgstr "Angola"

msgid "Anguilla"
msgstr "Anguilla"

msgid "Antarctica"
msgstr "Antártida"

msgid "Antigua and Barbuda"
msgstr "Antígua e Barbuda"

msgid "Any code you can get for the second step: one of your backup codes, or the one we email you."
msgstr "Qualquer código que você consiga para a segunda etapa: um dos seus códigos de backup ou o que enviamos por e-mail."

msgid "Any colour"
msgstr "Qualquer cor"

msgid "Any of these opens this same account. Unlink the ones you do not use."
msgstr "Qualquer uma destas abre esta mesma conta. Desvincule as que você não usa."

#. translators: %s: the account page, as a link
#, php-format
msgid "Anybody sent to their account lands on %s."
msgstr "Quem é enviado para a própria conta cai em %s."

msgid "Anybody who can reach the dashboard edits their details there as well as on the site."
