msgstr "um tamanho que este banco de dados não informa"

#. translators: %s: a date.
#: includes/admin-log.php:355
#, php-format
msgid "The oldest row is from %s."
msgstr "A linha mais antiga é de %s."

#: includes/admin-log.php:365
