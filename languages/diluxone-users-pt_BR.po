msgstr ""
"O formulário de perfil mostra dois blocos: o essencial primeiro, e embaixo "
"os opcionais com a sua própria explicação. Isto decide em qual deles o campo "
"cai."

#: includes/admin-fields.php:845
msgid "Help text"
msgstr "Texto de ajuda"

#: includes/admin-fields.php:849
msgid "Why we are asking. Shown under the field."
msgstr "Por que estamos perguntando. Mostrado abaixo do campo."

#: includes/admin-fields.php:866
