#. translators: 1: sections shown, 2: sections there are
#, php-format
msgid "%1$d of %2$d shown."
msgstr "%1$d von %2$d angezeigt."

#. translators: 1: how long ago, 2: device and browser, 3: IP address
#, php-format
msgid "%1$s ago, from %2$s (%3$s)"
msgstr "vor %1$s, von %2$s (%3$s)"

#. translators: 1: the address, 2: what else is there
#, php-format
msgid "%1$s is also %2$s, which nobody can reach while the sign-in page answers there."
msgstr "%1$s ist auch die Adresse für %2$s, den niemand erreichen kann, solange die Anmeldeseite dort antwortet."

#. translators: 1: how many people, 2: how many accounts in total
#, php-format
msgid "%1$s of %2$s"
msgstr "%1$s von %2$s"

#. translators: 1: number of people, 2: current page, 3: total pages
#, php-format
msgid "%1$s people with an open session · page %2$d of %3$d"
msgstr "%1$s Personen mit offener Sitzung · Seite %2$d von %3$d"

#. translators: 1: number of rows, 2: current page, 3: total pages
#, php-format
msgid "%1$s rows · page %2$d of %3$d"
msgstr "%1$s Zeilen · Seite %2$d von %3$d"

#. translators: 1: how long with "remember me" (a number of days, or what WordPress decides), 2: the same without it
#, php-format
msgid "%1$s with “remember me”, %2$s without. The e-mail link always counts as “remember me”."
msgstr "%1$s mit „Angemeldet bleiben“, %2$s ohne. Der E-Mail-Link zählt immer als „Angemeldet bleiben“."

#. translators: 1: plugin name, 2: screen name
#, php-format
msgctxt "title of a dashboard screen"
msgid "%1$s | %2$s"
msgstr "%1$s | %2$s"

#. translators: 1: percentage done, 2: additions looked at, 3: additions in all
#, php-format
msgid "%1$s%% (%2$s of %3$s)"
msgstr "%1$s%% (%2$s von %3$s)"

#. translators: 1: provider name, 2: how it stands, in a sentence
#, php-format
msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

#. translators: %d: number of providers
#, php-format
msgid "%d provider configured and enabled."
msgid_plural "%d providers configured and enabled."
msgstr[0] "%d Anbieter eingerichtet und aktiviert."
msgstr[1] "%d Anbieter eingerichtet und aktiviert."

#. translators: %d: how many refused sign-in attempts are kept.
#, php-format
msgid "%d refused sign-in attempt that typed this person's username or e-mail was kept: it is security evidence, and it is deleted when the activity log's retention runs out."
msgid_plural "%d refused sign-in attempts that typed this person's username or e-mail were kept: they are security evidence, and they are deleted when the activity log's retention runs out."
msgstr[0] "%d abgelehnter Anmeldeversuch, der den Benutzernamen oder die E-Mail-Adresse dieser Person eingegeben hat, wurde behalten: Er ist ein Sicherheitsnachweis und wird gelöscht, wenn die Aufbewahrungsfrist des Aktivitätsprotokolls abläuft."
msgstr[1] "%d abgelehnte Anmeldeversuche, die den Benutzernamen oder die E-Mail-Adresse dieser Person eingegeben haben, wurden behalten: Sie sind Sicherheitsnachweise und werden gelöscht, wenn die Aufbewahrungsfrist des Aktivitätsprotokolls abläuft."

#. translators: %d: number of settings written
#, php-format
msgid "%d setting restored."
msgid_plural "%d settings restored."
msgstr[0] "%d Einstellung wiederhergestellt."
msgstr[1] "%d Einstellungen wiederhergestellt."

#. translators: %d: number of failing checks
#, php-format
msgid "%d thing needs attention."
msgid_plural "%d things need attention."
msgstr[0] "%d Sache braucht Aufmerksamkeit."
msgstr[1] "%d Sachen brauchen Aufmerksamkeit."

#. translators: %d: how many times it can be changed
#, php-format
msgid "%d time"
msgid_plural "%d times"
msgstr[0] "%d Mal"
msgstr[1] "%d Mal"

#. translators: %s: how many sessions were closed at once.
#, php-format
msgid "%s closed"
msgstr "%s geschlossen"

#. translators: %s: a number of days
#, php-format
msgid "%s day"
msgid_plural "%s days"
msgstr[0] "%s Tag"
msgstr[1] "%s Tage"

#. translators: %s: one or more placeholders, e.g. {link}
#, php-format
msgid "%s has to stay in whatever you write: without it the message is a dead end, so a save that lost it is refused."
msgstr "%s muss in allem bleiben, was du schreibst: Ohne ihn ist die Nachricht eine Sackgasse, also wird ein Speichern, das ihn verloren hat, abgelehnt."

#. translators: %s: the ways in that are never behind a tab, comma separated
#, php-format
msgid "%s is not in this list and never goes behind a tab: it is the fastest way in there is, a tab would cost it a click, and inside one the browser never gets to offer it as the address field is focused."
msgstr "%s steht nicht in dieser Liste und kommt nie hinter einen Reiter: Es ist der schnellste Weg hinein, den es gibt, ein Reiter würde ihn einen Klick kosten, und darin kommt der Browser nie dazu, ihn anzubieten, weil der Fokus im Adressfeld liegt."

#. translators: %s: number of jobs
#, php-format
msgid "%s job is adding people in the background."
msgid_plural "%s jobs are adding people in the background."
msgstr[0] "%s Auftrag fügt im Hintergrund Personen hinzu."
msgstr[1] "%s Aufträge fügen im Hintergrund Personen hinzu."

#. translators: %s: number of sites
#, php-format
msgid "%s live site."
msgid_plural "%s live sites."
msgstr[0] "%s aktive Website."
msgstr[1] "%s aktive Websites."

#. translators: %s: how many people have a session open
#, php-format
msgid "%s person has a session open."
msgid_plural "%s people have a session open."
msgstr[0] "%s Person hat eine offene Sitzung."
msgstr[1] "%s Personen haben eine offene Sitzung."

#. translators: %s: number of sites
#, php-format
msgid "%s site on this network."
msgid_plural "%s sites on this network."
msgstr[0] "%s Website in diesem Netzwerk."
msgstr[1] "%s Websites in diesem Netzwerk."

#. translators: %s: how many suggested fields are not on the list
#, php-format
msgid "%s suggested field is not on the list."
msgid_plural "%s suggested fields are not on the list."
msgstr[0] "%s vorgeschlagenes Feld steht nicht auf der Liste."
msgstr[1] "%s vorgeschlagene Felder stehen nicht auf der Liste."

#. translators: %s: a percentage, already rounded
#, php-format
msgid "%s%%"
msgstr "%s %%"

#. translators: Accessibility text.
msgid "(opens in a new tab)"
msgstr "(öffnet in einem neuen Tab)"

msgid "0 for what WordPress decides, 14 days. The sign-in link always counts as “remember me”: there is no password to type again."
msgstr "0 für das, was WordPress entscheidet, 14 Tage. Der Anmeldelink zählt immer als „Angemeldet bleiben“: Es gibt kein Passwort, das erneut eingegeben werden müsste."

msgid "0 for what WordPress decides, 2 days. What somebody gets when they leave the box unticked on a form that offers it."
msgstr "0 für das, was WordPress entscheidet, 2 Tage. Das bekommt, wer das Kästchen in einem Formular, das es anbietet, nicht anhakt."

msgid "0 means whenever they like. A name that changes every day does not identify anybody, and the old address stops working each time."
msgstr "0 heißt: wann immer sie wollen. Ein Name, der sich täglich ändert, identifiziert niemanden, und die alte Adresse funktioniert jedes Mal nicht mehr."

msgid "2FA"
msgstr "2FA"

msgid "A bar down the left"
msgstr "Ein Balken links"

msgid "A border and the text in the accent, on the page’s own ground. For a design where a block of colour would be too loud."
msgstr "Ein Rand und der Text in der Akzentfarbe, auf dem Grund der Seite. Für ein Design, in dem ein Farbblock zu laut wäre."

msgid "A box under Security in their account area, with one line per device. Unticked, the box is not there and closing a session stays an administrator’s job, from the report of open sessions."
msgstr "Ein Kasten unter Sicherheit im eigenen Kontobereich, mit einer Zeile je Gerät. Nicht angehakt, ist der Kasten nicht da und eine Sitzung zu schließen bleibt Sache derer, die die Website verwalten, vom Bericht der offenen Sitzungen aus."

msgid "A brand new project needs no API enabled: sign-in works with the OAuth client alone. What does stop it is leaving the app in “Testing” and forgetting to add the person as a test user — they get “access blocked”."
msgstr "Ein brandneues Projekt braucht keine aktivierte API: Die Anmeldung funktioniert allein mit dem OAuth-Client. Was sie wirklich blockiert, ist, die App im „Test“ zu lassen und zu vergessen, die Person als Testnutzer einzutragen — sie bekommt „Zugriff blockiert“."

msgid "A button takes the colours the theme gives its own buttons, or yours."
msgstr "Ein Button übernimmt die Farben, die das Theme seinen eigenen Buttons gibt, oder deine."

msgid "A button to their details"
msgstr "Ein Button zu den eigenen Daten"

msgid "A centred card"
msgstr "Eine zentrierte Karte"

msgid "A change in their security"
msgstr "Eine Änderung an ihrer Sicherheit"

msgid "A class, as <code>.is-dark</code>, or an attribute, as <code>data-theme=\"dark\"</code>, or <code>data-mode</code> with any value."
msgstr "Eine Klasse, etwa <code>.is-dark</code>, oder ein Attribut, etwa <code>data-theme=\"dark\"</code>, oder <code>data-mode</code> mit beliebigem Wert."

msgid "A code by email"
msgstr "Ein Code per E-Mail"

msgid "A code is on its way"
msgstr "Ein Code ist unterwegs"

msgid "A code sent to the inbox the person has just opened to follow the link proves nothing the link did not prove already. An app does, so on an app it asks."
msgstr "Ein Code in genau das Postfach, das die Person gerade geöffnet hat, um dem Link zu folgen, belegt nichts, was der Link nicht schon belegt hätte. Eine App schon, also fragt es bei einer App."

msgid "A colour of its own"
msgstr "Eine eigene Farbe"

msgid "A colour of “Sign in” was not a colour, so it keeps the one it had."
msgstr "Eine Farbe von „Anmelden“ war keine Farbe, daher bleibt die bisherige."

msgid "A current code, to confirm it is you"
msgstr "Ein aktueller Code, um zu bestätigen, dass du es bist"

#. translators: %s: provider name
#, php-format
msgid "A direct link to sign in with %s, if you want it somewhere else"
msgstr "Ein direkter Link, um sich mit %s anzumelden, falls du ihn woanders willst"

msgid "A door in the site’s own menu: “Sign in” for visitors, and for whoever is signed in their photo or their name, with their account, the dashboard if they can use it, and a way out underneath. The theme draws it like the rest of the menu."
msgstr "Eine Tür im eigenen Menü der Website: „Anmelden“ für Besucher, und für wer angemeldet ist, sein Foto oder sein Name, darunter sein Konto, das Dashboard, wenn er es nutzen kann, und ein Weg hinaus. Das Theme zeichnet es wie den Rest des Menüs."

msgid "A few questions many sites ask the people who register. None of them is asked until it is added here: tick the ones this site needs and they join the list, where each can be edited, made required, moved or deleted like any other field."
msgstr "Ein paar Fragen, die viele Websites Menschen bei der Registrierung stellen. Keine davon wird gestellt, bevor sie hier hinzugefügt wird: Hake die an, die diese Website braucht, und sie kommen auf die Liste, wo sich jede wie jedes andere Feld bearbeiten, zur Pflicht machen, verschieben oder löschen lässt."

msgid "A few rows per person per day: this is the group that grows with how often people come back."
msgstr "Ein paar Zeilen pro Person und Tag: das ist die Gruppe, die damit wächst, wie oft Leute wiederkommen."

msgid "A field needs a name."
msgstr "Ein Feld braucht einen Namen."

msgid "A file with everything this site keeps about you: your details, and what the site and its plugins record about you. You get an email to confirm; once you do, we prepare it and it shows up here to download."
msgstr "Eine Datei mit allem, was diese Website über dich speichert: deine Angaben und was die Website und ihre Plugins über dich erfassen. Du bekommst eine E-Mail zur Bestätigung; sobald du bestätigst, bereiten wir sie vor und sie erscheint hier zum Herunterladen."

msgid "A filled button"
msgstr "Ein gefüllter Button"

msgid "A filled button, a link, the section of the menu somebody is reading, and the initials drawn for anybody with no photo. Everything else — the grounds, the lines, the quiet text — the plugin builds around it. Each of these reads under white letters and as a link on white."
msgstr "Eine gefüllte Schaltfläche, ein Link, der Menüabschnitt, den jemand gerade liest, und die Initialen, die für alle ohne Foto gezeichnet werden. Alles andere — die Flächen, die Linien, der leise Text — baut das Plugin darum herum. Jede dieser Farben ist unter weißer Schrift und als Link auf Weiß lesbar."

msgid "A form with every field on it, for whoever is signed in to fill in and save. Somebody who is not signed in sees nothing at all in its place."
msgstr "Ein Formular mit allen Feldern, das ausfüllt und speichert, wer angemeldet ist. Wer nicht angemeldet ist, sieht an seiner Stelle überhaupt nichts."

#. translators: %s: e-mail address
#, php-format
msgid "A fresh code is on its way to %s."
msgstr "Ein neuer Code ist unterwegs zu %s."

msgid "A fresh install records nothing, and has no table to record it in until a group is ticked here. Each one is ticked by whoever will be paying for the rows — which is why each one says roughly what it costs."
msgstr "Eine frische Installation zeichnet nichts auf und hat keine Tabelle dafür, bis hier eine Gruppe angehakt wird. Jede hakt an, wer die Zeilen bezahlen wird — deshalb sagt jede ungefähr, was sie kostet."

msgid "A grid with every section visible"
msgstr "Ein Raster, in dem jeder Abschnitt zu sehen ist"

msgid "A line under the open section. Down the side it becomes a bar down the left, because a line under a stacked item runs across the whole menu."
msgstr "Eine Linie unter dem offenen Abschnitt. Seitlich wird daraus ein Balken links, denn eine Linie unter einem gestapelten Eintrag zieht sich quer durch das ganze Menü."

msgid "A link e-mailed to the address on the account"
msgstr "Ein Link per E-Mail an die Adresse des Kontos"

msgid "A link, like the rest of the menu"
msgstr "Ein Link, wie der Rest des Menüs"

msgid "A menu down the side"
msgstr "Ein Menü an der Seite"

#. translators: %s: the e-mail address of a new account
#, php-format
msgid "A new account, %s, on every site"
msgstr "Ein neues Konto, %s, auf jeder Website"

msgid "A new password closes every session the account had open"
msgstr "Ein neues Passwort beendet jede Sitzung, die das Konto offen hatte"

msgid "A page of its own"
msgstr "Eine eigene Seite"

#. translators: %s: the address of the sign-in page
#, php-format
msgid "A page of its own, at %s."
msgstr "Eine eigene Seite, unter %s."

msgid "A panel in the page, the way a settings screen looks. It sits quietly inside whatever the theme already draws."
msgstr "Ein Panel in der Seite, so wie ein Einstellungsbildschirm aussieht. Es bleibt ruhig innerhalb dessen, was das Theme ohnehin zeichnet."

msgid "A phone number of the wrong length"
msgstr "Eine Telefonnummer mit falscher Länge"

msgid "A registration form of the site’s own"
msgstr "Ein eigenes Registrierungsformular der Website"

msgid "A screen of its own at an address you choose, with your mark and colours and none of the theme’s header or footer. No page to create."
msgstr "Ein eigener Bildschirm unter einer Adresse deiner Wahl, mit deinem Logo und deinen Farben und ohne Kopf- und Fußbereich des Themes. Keine Seite anzulegen."

msgid "A screen that comes back from a refused attempt ignores this and shows the way in that was refused, whatever it says here: a message about an address, read over a password form, explains nothing."
msgstr "Ein Bildschirm, der von einem abgelehnten Versuch zurückkommt, übergeht das hier und zeigt den Weg hinein, der abgelehnt wurde, was hier auch stehen mag: Eine Meldung über eine Adresse, über einem Passwortformular gelesen, erklärt nichts."

msgid "A second step is asked, as set on Security."
msgstr "Ein zweiter Schritt wird verlangt, wie unter Sicherheit eingestellt."

msgid "A secret is saved. Leave this empty to keep it, or paste a new one to replace it."
msgstr "Es ist ein Secret gespeichert. Leer lassen, um es zu behalten, oder ein neues einfügen, um es zu ersetzen."

msgid "A session is what keeps somebody signed in after they close the tab. Here is how long one lasts on this site, and whether each person can see their own."
msgstr "Eine Sitzung ist das, was jemanden angemeldet hält, nachdem der Reiter zu ist. Hier steht, wie lange eine auf dieser Website dauert, und ob jede Person ihre eigenen sehen kann."

msgid "A sign-in from a new device"
msgstr "Eine Anmeldung von einem neuen Gerät"

#. translators: %d: minutes
#, php-format
msgid "A single-use link, good for %d minutes."
msgstr "Ein Einmal-Link, %d Minuten lang gültig."

msgid "A social account"
msgstr "Ein Social-Konto"

msgid "A social account only signs in people who already have one here."
msgstr "Ein Social-Konto meldet nur Leute an, die hier schon eines haben."

msgid "A soft box in the colour of what it says"
msgstr "Ein sanfter Kasten in der Farbe dessen, was er sagt"

msgid "A spacing of the menu was not a length in px or rem, so it keeps the one it had."
msgstr "Ein Abstand des Menüs war keine Länge in px oder rem, daher bleibt der bisherige."

#. translators: %s: e-mail address
#, php-format
msgid "A test message is on its way to %s. If it does not arrive, nothing else will either."
msgstr "Eine Testnachricht ist unterwegs an %s. Kommt sie nicht an, kommt auch sonst nichts an."

msgid "A username and a password"
msgstr "Ein Benutzername und ein Passwort"

msgid "A web address cannot have spaces, so one of the two has to happen. The first is what almost everybody expects; the second is for a site that would rather nobody ends up with a name they did not type."
msgstr "Eine Webadresse darf keine Leerzeichen enthalten, also muss eines von beiden passieren. Das Erste erwarten fast alle; das Zweite ist für eine Website, der es lieber ist, dass niemand mit einem Namen endet, den er nicht getippt hat."

#. translators: %s: provider name
#, php-format
msgid "A window opens, %s asks you to authorise, and it comes back here. Nobody is signed in and nothing is saved to your account — it only checks that the round trip works. Until it does, the button cannot be enabled."
msgstr "Ein Fenster geht auf, %s bittet dich um Autorisierung, und es kommt hierher zurück. Niemand wird angemeldet und nichts wird in deinem Konto gespeichert — es wird nur geprüft, ob der Hin- und Rückweg funktioniert. Bis er das tut, kann die Schaltfläche nicht aktiviert werden."

msgid "A word between square brackets, typed into a page. Nobody visiting the site ever sees the brackets: while the page is being drawn, WordPress swaps the line for the real thing — a form, a list, a set of buttons. Put it twice and the thing appears twice; delete the line and it is gone. Nothing else on the page is affected."
msgstr "Ein Wort in eckigen Klammern, in eine Seite getippt. Niemand, der die Website besucht, sieht die Klammern: Während die Seite gezeichnet wird, tauscht WordPress die Zeile gegen die Sache selbst — ein Formular, eine Liste, eine Reihe von Schaltflächen. Schreiben Sie sie zweimal, erscheint die Sache zweimal; löschen Sie die Zeile, ist sie weg. Sonst ändert sich nichts an der Seite."

msgid "About"
msgstr "Über uns"

msgid "Above all of them, always"
msgstr "Über allen, immer"

msgid "Above and below"
msgstr "Oben und unten"

msgid "Accent"
msgstr "Akzent"

msgid "Accent colour"
msgstr "Akzentfarbe"

msgid "Access"
msgstr "Zugang"

msgid "Access › Summary →"
msgstr "Zugang › Übersicht →"

msgid "Access › The sign-in page →"
msgstr "Zugang › Die Anmeldeseite →"

msgid "Access →"
msgstr "Zugang →"

msgid "Account area"
msgstr "Kontobereich"

msgid "Account details and sign-in methods"
msgstr "Kontodaten und Anmeldemethoden"

msgid "Account linked."
msgstr "Konto verknüpft."

msgid "Account page"
msgstr "Kontoseite"

msgid "Account sections"
msgstr "Kontobereiche"

msgid "Accounts"
msgstr "Konten"

#. translators: %s: the ways an account gets created, comma separated
#, php-format
msgid "Accounts are created by: %s."
msgstr "Konten werden angelegt durch: %s."

#. translators: %s: the name of the site where the network's accounts live
#, php-format
msgid "Accounts are created on %s, for every site of the network. You come back here afterwards."
msgstr "Konten werden auf %s erstellt, für alle Websites des Netzwerks. Danach kommst du hierher zurück."

msgid "Accounts are made by whoever administers the site, under Users. Every door below is shut, WordPress’s own form on Settings → General included."
msgstr "Konten legt an, wer die Website verwaltet, unter Benutzer. Jede Tür unten ist zu, samt WordPress’ eigenem Formular unter Einstellungen → Allgemein."

msgid "Accounts made by the e-mail link or a social network were never asked for them. Once signed in, they are shown those fields alone on the account page, and then go on to where they were going. They can skip it, and are asked again at the next sign-in."
msgstr "Konten, die über den E-Mail-Link oder ein soziales Netzwerk entstanden sind, wurden nie danach gefragt. Nach der Anmeldung sehen sie auf der Kontoseite nur diese Felder und gehen dann weiter, wohin sie wollten. Der Schritt lässt sich überspringen und wird bei der nächsten Anmeldung wieder gezeigt."

msgid "Across the top, where the row begins, sits in the middle or ends. Down the side it is where the words in each line begin, which is the same question asked of a column."
msgstr "Oben dort, wo die Reihe beginnt, in der Mitte oder am Ende. Seitlich ist es, wo die Wörter jeder Zeile beginnen — dieselbe Frage, an eine Spalte gestellt."

msgid "Actions"
msgstr "Aktionen"

msgid "Activate DiluxOne Users+ for the whole network"
msgstr "DiluxOne Users+ für das ganze Netzwerk aktivieren"

msgid "Active"
msgstr "Aktiv"

msgid "Active: it shows up in the forms"
msgstr "Aktiv: Es taucht in den Formularen auf"

msgid "Activity"
msgstr "Aktivität"

msgid "Activity log"
msgstr "Aktivitätsprotokoll"

msgid "Add a block and pick the one called “Shortcode”. Typing “shortcode” into the block search finds it."
msgstr "Fügen Sie einen Block hinzu und wählen Sie den mit dem Namen „Shortcode“. Wer „Shortcode“ in die Blocksuche tippt, findet ihn."

msgid "Add a section"
msgstr "Bereich hinzufügen"

msgid "Add field"
msgstr "Feld hinzufügen"

msgid "Add one and from then on it opens this account too. Nothing gets duplicated: it is the same account with another way in."
msgstr "Füge eines hinzu und von da an öffnet es dieses Konto ebenfalls. Nichts wird doppelt angelegt: Es ist dasselbe Konto mit einem weiteren Weg hinein."

msgid "Add suggested fields"
msgstr "Vorgeschlagene Felder hinzufügen"

msgid "Add the ones ticked"
msgstr "Die angehakten hinzufügen"

msgid "Added by something else on this site"
msgstr "Von etwas anderem auf dieser Website hinzugefügt"

msgid "Adding everybody to every site has started. It goes on in the background, a batch at a time; its progress is below."
msgstr "Alle werden jetzt jeder Website hinzugefügt. Das läuft im Hintergrund weiter, Stapel für Stapel; der Fortschritt steht unten."

msgid "Additional details"
msgstr "Zusätzliche Angaben"

msgid "Address"
msgstr "Adresse"

msgid "After sign-in"
msgstr "Nach der Anmeldung"

msgid "After signing in, ask for the required fields the account has no answer for"
msgstr "Nach der Anmeldung nach den Pflichtfeldern fragen, für die das Konto keine Antwort hat"

msgid "After the door"
msgstr "Nach der Tür"

msgid "After the link is sent"
msgstr "Nachdem der Link verschickt wurde"

msgid "After what the plugin shows"
msgstr "Nach dem, was das Plugin zeigt"

msgid "All the doors"
msgstr "Alle Türen"

msgid "Almost nothing, and it is the group worth having when an account is taken over."
msgstr "Fast nichts — und es ist die Gruppe, die man haben will, wenn ein Konto übernommen wird."

msgid "Almost nothing: most people change these once and never again."
msgstr "Fast nichts: die meisten ändern das einmal und nie wieder."

msgid "Already have an account?"
msgstr "Hast du schon ein Konto?"

msgid "Always ask"
msgstr "Immer verlangen"

msgid "Always in tabs"
msgstr "Immer in Reitern"

msgid "Always sent"
msgstr "Wird immer geschickt"

msgid "Always sent — no switch for anybody"
msgstr "Wird immer geschickt — kein Schalter für niemanden"

msgid "Always stacked"
msgstr "Immer gestapelt"

msgid "An account belongs to the whole network; being a member of a site — having a role on it — is each site’s. This decides which sites an account is a member of, for every site of the network."
msgstr "Ein Konto gehört dem ganzen Netzwerk; Mitglied einer Website zu sein – dort eine Rolle zu haben – ist Sache der jeweiligen Website. Hier wird entschieden, von welchen Websites ein Konto Mitglied ist, für jede Website des Netzwerks."

msgid "An account with admin permissions cannot ask for its own deletion."
msgstr "Ein Konto mit Administrationsrechten kann seine eigene Löschung nicht beantragen."

msgid "An authenticator app"
msgstr "Eine Authenticator-App"

msgid "An icon inside the buttons of the doors: an envelope on the link"
