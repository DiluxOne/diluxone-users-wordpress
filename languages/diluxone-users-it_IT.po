#. translators: 1: sections shown, 2: sections there are
#, php-format
msgid "%1$d of %2$d shown."
msgstr "%1$d di %2$d mostrati."

#. translators: 1: how long ago, 2: device and browser, 3: IP address
#, php-format
msgid "%1$s ago, from %2$s (%3$s)"
msgstr "%1$s fa, da %2$s (%3$s)"

#. translators: 1: the address, 2: what else is there
#, php-format
msgid "%1$s is also %2$s, which nobody can reach while the sign-in page answers there."
msgstr "%1$s è anche l’indirizzo di %2$s, che nessuno può raggiungere finché la pagina di accesso risponde lì."

#. translators: 1: how many people, 2: how many accounts in total
#, php-format
msgid "%1$s of %2$s"
msgstr "%1$s su %2$s"

#. translators: 1: number of people, 2: current page, 3: total pages
#, php-format
msgid "%1$s people with an open session · page %2$d of %3$d"
msgstr "%1$s persone con una sessione aperta · pagina %2$d di %3$d"

#. translators: 1: number of rows, 2: current page, 3: total pages
#, php-format
msgid "%1$s rows · page %2$d of %3$d"
msgstr "%1$s righe · pagina %2$d di %3$d"

#. translators: 1: how long with "remember me" (a number of days, or what WordPress decides), 2: the same without it
#, php-format
msgid "%1$s with “remember me”, %2$s without. The e-mail link always counts as “remember me”."
msgstr "%1$s con “Ricordami”, %2$s senza. Il link via email conta sempre come “Ricordami”."

#. translators: 1: plugin name, 2: screen name
#, php-format
msgctxt "title of a dashboard screen"
msgid "%1$s | %2$s"
msgstr "%1$s | %2$s"

#. translators: 1: percentage done, 2: additions looked at, 3: additions in all
#, php-format
msgid "%1$s%% (%2$s of %3$s)"
msgstr "%1$s%% (%2$s di %3$s)"

#. translators: 1: provider name, 2: how it stands, in a sentence
#, php-format
msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

#. translators: %d: number of providers
#, php-format
msgid "%d provider configured and enabled."
msgid_plural "%d providers configured and enabled."
msgstr[0] "%d provider configurato e attivo."
msgstr[1] "%d provider configurati e attivi."

#. translators: %d: how many refused sign-in attempts are kept.
#, php-format
msgid "%d refused sign-in attempt that typed this person's username or e-mail was kept: it is security evidence, and it is deleted when the activity log's retention runs out."
msgid_plural "%d refused sign-in attempts that typed this person's username or e-mail were kept: they are security evidence, and they are deleted when the activity log's retention runs out."
msgstr[0] "È stato conservato %d tentativo di accesso rifiutato che ha digitato il nome utente o l’e-mail di questa persona: è una prova di sicurezza e viene cancellato quando scade la conservazione del registro delle attività."
msgstr[1] "Sono stati conservati %d tentativi di accesso rifiutati che hanno digitato il nome utente o l’e-mail di questa persona: sono prove di sicurezza e vengono cancellati quando scade la conservazione del registro delle attività."

#. translators: %d: number of settings written
#, php-format
msgid "%d setting restored."
msgid_plural "%d settings restored."
msgstr[0] "%d impostazione ripristinata."
msgstr[1] "%d impostazioni ripristinate."

#. translators: %d: number of failing checks
#, php-format
msgid "%d thing needs attention."
msgid_plural "%d things need attention."
msgstr[0] "%d cosa richiede attenzione."
msgstr[1] "%d cose richiedono attenzione."

#. translators: %d: how many times it can be changed
#, php-format
msgid "%d time"
msgid_plural "%d times"
msgstr[0] "%d volta"
msgstr[1] "%d volte"

#. translators: %s: how many sessions were closed at once.
#, php-format
msgid "%s closed"
msgstr "%s chiuse"

#. translators: %s: a number of days
#, php-format
msgid "%s day"
msgid_plural "%s days"
msgstr[0] "%s giorno"
msgstr[1] "%s giorni"

#. translators: %s: one or more placeholders, e.g. {link}
#, php-format
msgid "%s has to stay in whatever you write: without it the message is a dead end, so a save that lost it is refused."
msgstr "%s deve restare in qualunque cosa scrivi: senza, il messaggio è un vicolo cieco, quindi un salvataggio che l’ha perso viene rifiutato."

#. translators: %s: the ways in that are never behind a tab, comma separated
#, php-format
msgid "%s is not in this list and never goes behind a tab: it is the fastest way in there is, a tab would cost it a click, and inside one the browser never gets to offer it as the address field is focused."
msgstr "%s non è in questo elenco e non finisce mai dietro una scheda: è il modo di entrare più veloce che ci sia, una scheda gli costerebbe un clic, e dentro una il browser non arriva mai a proporlo perché il fuoco è nel campo dell’indirizzo."

#. translators: %s: number of jobs
#, php-format
msgid "%s job is adding people in the background."
msgid_plural "%s jobs are adding people in the background."
msgstr[0] "%s attività sta aggiungendo persone in background."
msgstr[1] "%s attività stanno aggiungendo persone in background."

#. translators: %s: number of sites
#, php-format
msgid "%s live site."
msgid_plural "%s live sites."
msgstr[0] "%s sito attivo."
msgstr[1] "%s siti attivi."

#. translators: %s: how many people have a session open
#, php-format
msgid "%s person has a session open."
msgid_plural "%s people have a session open."
msgstr[0] "%s persona ha una sessione aperta."
msgstr[1] "%s persone hanno una sessione aperta."

#. translators: %s: number of sites
#, php-format
msgid "%s site on this network."
msgid_plural "%s sites on this network."
msgstr[0] "%s sito in questa rete."
msgstr[1] "%s siti in questa rete."

#. translators: %s: how many suggested fields are not on the list
#, php-format
msgid "%s suggested field is not on the list."
msgid_plural "%s suggested fields are not on the list."
msgstr[0] "%s campo suggerito non è nell’elenco."
msgstr[1] "%s campi suggeriti non sono nell’elenco."

#. translators: %s: a percentage, already rounded
#, php-format
msgid "%s%%"
msgstr "%s%%"

#. translators: Accessibility text.
msgid "(opens in a new tab)"
msgstr "(si apre in una scheda nuova)"

msgid "0 for what WordPress decides, 14 days. The sign-in link always counts as “remember me”: there is no password to type again."
msgstr "0 per quello che decide WordPress, 14 giorni. Il link di accesso conta sempre come “Ricordami”: non c’è una password da riscrivere."

msgid "0 for what WordPress decides, 2 days. What somebody gets when they leave the box unticked on a form that offers it."
msgstr "0 per quello che decide WordPress, 2 giorni. Quello che ottiene chi lascia la casella non selezionata in un modulo che la offre."

msgid "0 means whenever they like. A name that changes every day does not identify anybody, and the old address stops working each time."
msgstr "0 significa quando vogliono. Un nome che cambia ogni giorno non identifica nessuno, e l’indirizzo vecchio smette di funzionare ogni volta."

msgid "2FA"
msgstr "2FA"

msgid "A bar down the left"
msgstr "Una barra a sinistra"

msgid "A bit more about you"
msgstr "Qualcosa in più su di te"

msgid "A border and the text in the accent, on the page’s own ground. For a design where a block of colour would be too loud."
msgstr "Un bordo e il testo nell’accento, sullo sfondo della pagina. Per un design dove un blocco di colore sarebbe troppo."

msgid "A box under Security in their account area, with one line per device. Unticked, the box is not there and closing a session stays an administrator’s job, from the report of open sessions."
msgstr "Un riquadro sotto Sicurezza nella propria area account, con una riga per dispositivo. Senza spunta il riquadro non c’è e chiudere una sessione resta compito di chi amministra, dal report delle sessioni aperte."

msgid "A brand new project needs no API enabled: sign-in works with the OAuth client alone. What does stop it is leaving the app in “Testing” and forgetting to add the person as a test user — they get “access blocked”."
msgstr "Un progetto nuovo non ha bisogno di attivare nessuna API: l’accesso funziona con il solo client OAuth. Quello che invece blocca è lasciare l’app in «Prova» e dimenticarsi di aggiungere la persona come utente di test: le compare «accesso bloccato»."

msgid "A button takes the colours the theme gives its own buttons, or yours."
msgstr "Un pulsante prende i colori che il tema dà ai propri pulsanti, oppure i tuoi."

msgid "A button to their details"
msgstr "Un pulsante ai suoi dati"

msgid "A centred card"
msgstr "Una scheda centrata"

msgid "A change in their security"
msgstr "Un cambio nella sua sicurezza"

msgid "A class, as <code>.is-dark</code>, or an attribute, as <code>data-theme=\"dark\"</code>, or <code>data-mode</code> with any value."
msgstr "Una classe, come <code>.is-dark</code>, o un attributo, come <code>data-theme=\"dark\"</code>, o <code>data-mode</code> con qualsiasi valore."

msgid "A code by email"
msgstr "Un codice via e-mail"

msgid "A code is on its way"
msgstr "Un codice è in arrivo"

msgid "A code sent to the inbox the person has just opened to follow the link proves nothing the link did not prove already. An app does, so on an app it asks."
msgstr "Un codice mandato nella stessa casella che la persona ha appena aperto per seguire il link non dimostra niente che il link non abbia già dimostrato. Un’app sì, quindi con un’app lo chiede."

msgid "A colour of its own"
msgstr "Un colore suo"

msgid "A colour of “Sign in” was not a colour, so it keeps the one it had."
msgstr "Un colore di “Accedi” non era un colore, quindi resta quello che aveva."

msgid "A current code, to confirm it is you"
msgstr "Un codice valido adesso, per confermare che sei tu"

#. translators: %s: provider name
#, php-format
msgid "A direct link to sign in with %s, if you want it somewhere else"
msgstr "Un link diretto per entrare con %s, se lo vuoi da un’altra parte"

msgid "A door in the site’s own menu: “Sign in” for visitors, and for whoever is signed in their photo or their name, with their account, the dashboard if they can use it, and a way out underneath. The theme draws it like the rest of the menu."
msgstr "Una porta nel menu del sito: «Accedi» per chi visita, e per chi ha effettuato l’accesso la sua foto o il suo nome, con il suo account, la bacheca se può usarla e un modo per uscire sotto. Il tema lo disegna come il resto del menu."

msgid "A few questions many sites ask the people who register. None of them is asked until it is added here: tick the ones this site needs and they join the list, where each can be edited, made required, moved or deleted like any other field."
msgstr "Alcune domande che molti siti fanno a chi si registra. Nessuna viene posta finché non viene aggiunta qui: seleziona quelle di cui questo sito ha bisogno ed entrano nell’elenco, dove ognuna può essere modificata, resa obbligatoria, spostata o eliminata come qualsiasi altro campo."

msgid "A few rows per person per day: this is the group that grows with how often people come back."
msgstr "Poche righe per persona al giorno: è il gruppo che cresce con la frequenza con cui le persone tornano."

msgid "A field needs a name."
msgstr "Un campo ha bisogno di un nome."

msgid "A file with everything this site keeps about you: your details, and what the site and its plugins record about you. You get an email to confirm; once you do, we prepare it and it shows up here to download."
msgstr "Un file con tutto ciò che questo sito conserva su di te: i tuoi dati, e ciò che il sito e i suoi plugin registrano su di te. Ti arriva un’e-mail per confermare; quando confermi, lo prepariamo e compare qui da scaricare."

msgid "A filled button"
msgstr "Un pulsante pieno"

msgid "A filled button, a link, the section of the menu somebody is reading, and the initials drawn for anybody with no photo. Everything else — the grounds, the lines, the quiet text — the plugin builds around it. Each of these reads under white letters and as a link on white."
msgstr "Un pulsante pieno, un link, la sezione del menu che qualcuno sta leggendo e le iniziali disegnate per chi non ha una foto. Tutto il resto — gli sfondi, le linee, il testo tenue — il plugin lo costruisce intorno. Ognuno di questi si legge sotto lettere bianche e come link sul bianco."

msgid "A form with every field on it, for whoever is signed in to fill in and save. Somebody who is not signed in sees nothing at all in its place."
msgstr "Un modulo con tutti i campi, perché chi ha effettuato l’accesso lo compili e lo salvi. Chi non ha effettuato l’accesso non vede assolutamente nulla al suo posto."

#. translators: %s: e-mail address
#, php-format
msgid "A fresh code is on its way to %s."
msgstr "Un codice nuovo è in arrivo verso %s."

msgid "A fresh install records nothing, and has no table to record it in until a group is ticked here. Each one is ticked by whoever will be paying for the rows — which is why each one says roughly what it costs."
msgstr "Una nuova installazione non registra nulla, e non ha una tabella dove registrarlo finché qui non si seleziona un gruppo. Ognuno lo seleziona chi pagherà le righe — ed è per questo che ognuno dice più o meno quanto costa."

msgid "A grid with every section visible"
msgstr "Una griglia con tutte le sezioni in vista"

msgid "A line under the open section. Down the side it becomes a bar down the left, because a line under a stacked item runs across the whole menu."
msgstr "Una linea sotto la sezione aperta. Di lato diventa una barra a sinistra, perché una linea sotto un elemento impilato attraversa tutto il menu."

msgid "A link e-mailed to the address on the account"
msgstr "Un link via e-mail all’indirizzo dell’account"

msgid "A link, like the rest of the menu"
msgstr "Un link, come il resto del menu"

msgid "A menu down the side"
msgstr "Un menu di lato"

#. translators: %s: the e-mail address of a new account
#, php-format
msgid "A new account, %s, on every site"
msgstr "Un nuovo account, %s, su ogni sito"

msgid "A new password closes every session the account had open"
msgstr "Una nuova password chiude tutte le sessioni aperte dell’account"

msgid "A page of its own"
msgstr "Una pagina a sé"

#. translators: %s: the address of the sign-in page
#, php-format
msgid "A page of its own, at %s."
msgstr "Una pagina a sé, su %s."

msgid "A panel in the page, the way a settings screen looks. It sits quietly inside whatever the theme already draws."
msgstr "Un pannello dentro la pagina, come appare una schermata di impostazioni. Sta tranquilla dentro a ciò che il tema già disegna."

msgid "A phone number of the wrong length"
msgstr "Un numero di telefono della lunghezza sbagliata"

msgid "A registration form of the site’s own"
msgstr "Un modulo di registrazione proprio del sito"

msgid "A screen of its own at an address you choose, with your mark and colours and none of the theme’s header or footer. No page to create."
msgstr "Una schermata a sé, all’indirizzo che scegli, con il tuo logo e i tuoi colori e senza intestazione né piè di pagina del tema. Nessuna pagina da creare."

msgid "A screen that comes back from a refused attempt ignores this and shows the way in that was refused, whatever it says here: a message about an address, read over a password form, explains nothing."
msgstr "Una schermata che torna da un tentativo rifiutato ignora questo e mostra il modo di entrare che è stato rifiutato, qualunque cosa dica qui: un messaggio su un indirizzo, letto sopra un modulo di password, non spiega nulla."

msgid "A second step is asked, as set on Security."
msgstr "Viene chiesto un secondo passaggio, come impostato in Sicurezza."

msgid "A secret is saved. Leave this empty to keep it, or paste a new one to replace it."
msgstr "C’è un segreto salvato. Lascia vuoto per mantenerlo, oppure incollane uno nuovo per sostituirlo."

msgid "A session is what keeps somebody signed in after they close the tab. Here is how long one lasts on this site, and whether each person can see their own."
msgstr "Una sessione è quello che tiene dentro qualcuno dopo che ha chiuso la scheda. Qui c’è quanto dura su questo sito, e se ogni persona può vedere le proprie."

msgid "A sign-in from a new device"
msgstr "Un accesso da un dispositivo nuovo"

#. translators: %d: minutes
#, php-format
msgid "A single-use link, good for %d minutes."
msgstr "Un link monouso, valido per %d minuti."

msgid "A social account"
msgstr "Un account social"

msgid "A social account only signs in people who already have one here."
msgstr "Un account social fa entrare solo chi ne ha già uno qui."

msgid "A soft box in the colour of what it says"
msgstr "Una scatola morbida nel colore di ciò che dice"

msgid "A spacing of the menu was not a length in px or rem, so it keeps the one it had."
msgstr "Una spaziatura del menu non era una lunghezza in px o rem, quindi resta quella che aveva."

#. translators: %s: e-mail address
#, php-format
msgid "A test message is on its way to %s. If it does not arrive, nothing else will either."
msgstr "Un messaggio di prova sta arrivando a %s. Se non arriva, non arriverà nient’altro."

msgid "A username and a password"
msgstr "Un nome utente e una password"

msgid "A web address cannot have spaces, so one of the two has to happen. The first is what almost everybody expects; the second is for a site that would rather nobody ends up with a name they did not type."
msgstr "Un indirizzo web non può contenere spazi, quindi deve succedere una delle due cose. La prima è quello che si aspettano quasi tutti; la seconda è per un sito che preferisce che nessuno resti con un nome che non ha scritto."

#. translators: %s: provider name
#, php-format
msgid "A window opens, %s asks you to authorise, and it comes back here. Nobody is signed in and nothing is saved to your account — it only checks that the round trip works. Until it does, the button cannot be enabled."
msgstr "Si apre una finestra, %s ti chiede di autorizzare, e torna qui. Non entra nessuno e non viene salvato niente sul tuo account — si controlla solo che l’andata e ritorno funzioni. Finché non funziona, il pulsante non si può attivare."

msgid "A word between square brackets, typed into a page. Nobody visiting the site ever sees the brackets: while the page is being drawn, WordPress swaps the line for the real thing — a form, a list, a set of buttons. Put it twice and the thing appears twice; delete the line and it is gone. Nothing else on the page is affected."
msgstr "Una parola tra parentesi quadre, scritta dentro una pagina. Nessuno che visiti il sito vede le parentesi: mentre la pagina viene disegnata, WordPress sostituisce la riga con la cosa vera — un modulo, un elenco, una serie di pulsanti. La metta due volte e la cosa compare due volte; cancelli la riga e sparisce. Nient’altro nella pagina viene toccato."

msgid "About"
msgstr "Chi siamo"

msgid "About you"
msgstr "Su di te"

msgid "Above all of them, always"
msgstr "Sopra tutti, sempre"

msgid "Above and below"
msgstr "Sopra e sotto"

msgid "Accent"
msgstr "Accento"

msgid "Accent colour"
msgstr "Colore d’accento"

msgid "Access"
msgstr "Accesso"

msgid "Access › Summary →"
msgstr "Accesso › Riepilogo →"

msgid "Access › The sign-in page →"
msgstr "Accesso › La pagina di accesso →"

msgid "Access →"
msgstr "Accesso →"

msgid "Account area"
msgstr "Area account"

msgid "Account details and sign-in methods"
msgstr "Dati dell’account e modi di accesso"

msgid "Account linked."
msgstr "Account collegato."

msgid "Account page"
msgstr "Pagina dell’account"

msgid "Account sections"
msgstr "Sezioni dell’account"

msgid "Accounts"
msgstr "Account"

#. translators: %s: the ways an account gets created, comma separated
#, php-format
msgid "Accounts are created by: %s."
msgstr "Gli account vengono creati da: %s."

#. translators: %s: the name of the site where the network's accounts live
#, php-format
msgid "Accounts are created on %s, for every site of the network. You come back here afterwards."
msgstr "Gli account si creano su %s, per tutti i siti della rete. Poi torni qui."

msgid "Accounts are made by whoever administers the site, under Users. Every door below is shut, WordPress’s own form on Settings → General included."
msgstr "Gli account li crea chi amministra il sito, in Utenti. Ogni porta qui sotto è chiusa, compreso il modulo di WordPress in Impostazioni → Generali."

msgid "Accounts made by the e-mail link or a social network were never asked for them. Once signed in, they are shown those fields alone on the account page, and then go on to where they were going. They can skip it, and are asked again at the next sign-in."
msgstr "Agli account creati con il link via e-mail o con un social network non sono mai stati chiesti. Dopo l’accesso vedono solo quei campi nella pagina dell’account, e poi proseguono dove stavano andando. Si può saltare, e viene chiesto di nuovo all’accesso successivo."

msgid "Across the top, where the row begins, sits in the middle or ends. Down the side it is where the words in each line begin, which is the same question asked of a column."
msgstr "In alto, dove la riga comincia, sta nel mezzo o finisce. Di lato è dove cominciano le parole di ogni riga, che è la stessa domanda fatta a una colonna."

msgid "Actions"
msgstr "Azioni"

msgid "Activate DiluxOne Users+ for the whole network"
msgstr "Attivare DiluxOne Users+ per tutta la rete"

msgid "Active"
msgstr "Attivo"

msgid "Active: it shows up in the forms"
msgstr "Attivo: compare nei moduli"

msgid "Activity"
msgstr "Attività"

msgid "Activity log"
msgstr "Registro attività"

msgid "Add a block and pick the one called “Shortcode”. Typing “shortcode” into the block search finds it."
msgstr "Aggiunga un blocco e scelga quello che si chiama «Shortcode». Scrivendo «shortcode» nella ricerca dei blocchi lo si trova."

msgid "Add a section"
msgstr "Aggiungi una sezione"

msgid "Add field"
msgstr "Aggiungi campo"

msgid "Add one and from then on it opens this account too. Nothing gets duplicated: it is the same account with another way in."
msgstr "Aggiungine uno e da lì in poi apre anche questo account. Non viene duplicato niente: è lo stesso account con un altro modo di entrare."

msgid "Add suggested fields"
msgstr "Aggiungi campi suggeriti"

msgid "Add the ones ticked"
msgstr "Aggiungi quelli selezionati"

msgid "Added by something else on this site"
msgstr "Aggiunto da qualcos’altro in questo sito"

msgid "Adding everybody to every site has started. It goes on in the background, a batch at a time; its progress is below."
msgstr "L’aggiunta di tutti a ogni sito è iniziata. Prosegue in background, un lotto alla volta; l’avanzamento è qui sotto."

msgid "Additional details"
msgstr "Dati aggiuntivi"

msgid "Address"
msgstr "Indirizzo"

msgid "Afghanistan"
msgstr "Afghanistan"

msgid "After sign-in"
msgstr "Dopo l’accesso"

msgid "After signing in, ask for the required fields the account has no answer for"
msgstr "Dopo l’accesso, chiedere i campi obbligatori a cui l’account non ha risposto"

msgid "After the door"
msgstr "Dopo la porta"

msgid "After the link is sent"
msgstr "Dopo che il link è stato inviato"

msgid "After what the plugin shows"
msgstr "Dopo quello che mostra il plugin"

msgid "Aland Islands"
msgstr "Isole Åland"

msgid "Albania"
msgstr "Albania"

msgid "Algeria"
msgstr "Algeria"

msgid "All the doors"
msgstr "Tutte le porte"

msgid "Almost nothing, and it is the group worth having when an account is taken over."
msgstr "Quasi nulla, ed è il gruppo che conviene avere quando un account viene rubato."

msgid "Almost nothing: most people change these once and never again."
msgstr "Quasi nulla: la maggior parte delle persone lo cambia una volta e mai più."

msgid "Already have an account?"
msgstr "Hai già un account?"

msgid "Always ask"
msgstr "Chiederlo sempre"

msgid "Always in tabs"
msgstr "Sempre in schede"

msgid "Always sent"
msgstr "Mandato sempre"

msgid "Always sent — no switch for anybody"
msgstr "Sempre inviato — nessun interruttore per nessuno"

msgid "Always stacked"
msgstr "Sempre impilati"

msgid "American Samoa"
msgstr "Samoa Americane"

msgid "An account belongs to the whole network; being a member of a site — having a role on it — is each site’s. This decides which sites an account is a member of, for every site of the network."
msgstr "Un account appartiene all’intero network; essere membro di un sito — avervi un ruolo — riguarda ciascun sito. Qui si decide di quali siti un account è membro, per ogni sito del network."

msgid "An account with admin permissions cannot ask for its own deletion."
msgstr "Un account con permessi di amministrazione non può chiedere la propria eliminazione."

msgid "An authenticator app"
msgstr "Un’app di autenticazione"

msgid "An icon inside the buttons of the doors: an envelope on the link"
msgstr "Un’icona dentro i pulsanti delle porte: una busta sul link"

msgid "An outlined button"
msgstr "Un pulsante con bordo"

msgid "And again"
msgstr "E di nuovo"

msgid "And the note under it"
msgstr "E la nota sotto"

msgid "And then, here"
msgstr "E poi, qui"

msgid "Andorra"
msgstr "Andorra"

msgid "Angola"
msgstr "Angola"

msgid "Anguilla"
msgstr "Anguilla"

msgid "Antarctica"
msgstr "Antartide"

msgid "Antigua and Barbuda"
msgstr "Antigua e Barbuda"

