msgstr "Isole Falkland"

msgid "Fall back to Gravatar when there is none"
msgstr "Ripiegare su Gravatar quando non ce n’è nessuna"

msgid "Faroe Islands"
msgstr "Isole Fær Øer"

msgid "Field deleted. The data already stored was left alone."
msgstr "Campo eliminato. I dati già salvati sono rimasti intatti."

