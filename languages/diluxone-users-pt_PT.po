msgstr "Quando é pedido"

#: includes/admin-2fa.php:231
msgid "Off: it is not offered at all"
msgstr "Desativado: não é oferecido"

#: includes/admin-2fa.php:257
msgid "With what"
msgstr "Com o quê"

#: includes/admin-2fa.php:253
msgid "To whom"
msgstr "Para quem"

#: includes/admin-2fa.php:306
msgid "Work it out: ask, unless the second step is another email"
msgstr "Decidir: pedir, a menos que a segunda etapa seja outro e-mail"

#: includes/admin-2fa.php:313
