msgid_plural "This site writes %1$d of the %2$d messages themselves, in %3$s."
msgstr[0] "Este site escreve %1$d das %2$d mensagens por conta própria, em %3$s."
msgstr[1] "Este site escreve %1$d das %2$d mensagens por conta própria, em %3$s."

