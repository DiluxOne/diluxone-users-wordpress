msgstr "un tamaño que esta base de datos no informa"

#. translators: %s: a date.
#: includes/admin-log.php:339
#, php-format
msgid "The oldest row is from %s."
msgstr "La fila más antigua es del %s."

#: includes/admin-log.php:349
msgid "kept for ever"
msgstr "se guarda para siempre"

#. translators: %s: a number of days.
#: includes/admin-log.php:352
#, php-format
msgid "kept %s days"
msgstr "se guarda %s días"

#: includes/admin-log.php:369
msgid "E-mail link"
msgstr "Enlace por correo"

#: includes/admin-log.php:370
