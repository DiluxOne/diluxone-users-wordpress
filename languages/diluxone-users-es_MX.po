msgstr "No se envía nada: no hay segundo paso."

#: includes/admin-account.php:1044
#: includes/admin-status.php:306
msgid "No account area: people edit their details on the dashboard profile, as WordPress has it."
msgstr "Sin área de cuenta: la gente edita sus datos en el perfil del escritorio, como viene de WordPress."

#: includes/admin-account.php:1061
msgid "As the plugin ships them, in an account area this site has not made yet: WordPress has none."
msgstr "Como vienen del plugin, en un área de cuenta que este sitio todavía no ha creado: WordPress no tiene ninguna."

#: includes/admin-account.php:1073
msgid "The name comes from their first and last name, as WordPress has it."
msgstr "El nombre sale de su nombre y apellido, como viene de WordPress."

