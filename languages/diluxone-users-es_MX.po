#: includes/admin-login.php:286
#, php-format
msgid "Accounts are created by: %s."
msgstr "Las cuentas las crea: %s."

#: includes/admin-login.php:290
msgid "Nobody registers themselves: accounts are made under Users."
msgstr "Nadie se registra por sí mismo: las cuentas se crean desde Usuarios."

#: includes/admin-login.php:295
msgid "After the door"
msgstr "Después de la puerta"

#: includes/admin-login.php:298
msgid "A second step is asked, as set on Security."
msgstr "Se pide un segundo paso, según lo configurado en Seguridad."

#: includes/admin-login.php:299
