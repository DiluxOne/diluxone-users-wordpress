msgstr "Proveedor guardado."

msgid "Providers"
msgstr "Proveedores"

msgid "Public name"
msgstr "Nombre público"

msgid "Public name changed"
msgstr "Ha cambiado el nombre público"

msgid "Public names are off, so the box only takes the e-mail address."
msgstr "Los nombres públicos están desactivados, así que el campo solo acepta la dirección de correo."

msgid "Publish the page and open it the way a visitor would. What the line stands for is what you see."
msgstr "Publica la página y ábrela como la abriría un visitante. Lo que la línea representa es lo que verás."

msgid "Put the plugin’s own words back"
msgstr "Devolver las palabras del plugin"

msgid "Put the site’s name, mark and colour on wp-login.php"
msgstr "Poner el nombre, la marca y el color del sitio en wp-login.php"

msgid "Quiet text"
msgstr "Texto callado"

msgid "Raspberry"
msgstr "Frambuesa"

msgid "Reachable"
msgstr "Se puede abrir"

msgid "Read only"
msgstr "Sólo lectura"

