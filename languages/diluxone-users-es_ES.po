#. translators: 1: sections shown, 2: sections there are
#, php-format
msgid "%1$d of %2$d shown."
msgstr "Se muestran %1$d de %2$d."

#. translators: 1: how long ago, 2: device and browser, 3: IP address
#, php-format
msgid "%1$s ago, from %2$s (%3$s)"
msgstr "hace %1$s, desde %2$s (%3$s)"

#. translators: 1: the address, 2: what else is there
#, php-format
msgid "%1$s is also %2$s, which nobody can reach while the sign-in page answers there."
msgstr "%1$s también es la dirección de %2$s, al que nadie puede llegar mientras la página de acceso responda ahí."

#. translators: 1: how many people, 2: how many accounts in total
#, php-format
msgid "%1$s of %2$s"
msgstr "%1$s de %2$s"

#. translators: 1: number of people, 2: current page, 3: total pages
#, php-format
msgid "%1$s people with an open session · page %2$d of %3$d"
msgstr "%1$s personas con la sesión abierta · página %2$d de %3$d"

#. translators: 1: number of rows, 2: current page, 3: total pages
#, php-format
msgid "%1$s rows · page %2$d of %3$d"
msgstr "%1$s filas · página %2$d de %3$d"

#. translators: 1: how long with "remember me" (a number of days, or what WordPress decides), 2: the same without it
#, php-format
msgid "%1$s with “remember me”, %2$s without. The e-mail link always counts as “remember me”."
msgstr "%1$s con “recuérdame”, %2$s sin. El enlace por correo siempre cuenta como “recuérdame”."

#. translators: 1: plugin name, 2: screen name
#, php-format
msgctxt "title of a dashboard screen"
msgid "%1$s | %2$s"
msgstr "%1$s | %2$s"

#. translators: 1: percentage done, 2: additions looked at, 3: additions in all
#, php-format
msgid "%1$s%% (%2$s of %3$s)"
msgstr "%1$s%% (%2$s de %3$s)"

#. translators: 1: provider name, 2: how it stands, in a sentence
#, php-format
msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

#. translators: %d: number of providers
#, php-format
msgid "%d provider configured and enabled."
msgid_plural "%d providers configured and enabled."
msgstr[0] "%d proveedor configurado y prendido."
msgstr[1] "%d proveedores configurados y prendidos."

#. translators: %d: how many refused sign-in attempts are kept.
#, php-format
msgid "%d refused sign-in attempt that typed this person's username or e-mail was kept: it is security evidence, and it is deleted when the activity log's retention runs out."
msgid_plural "%d refused sign-in attempts that typed this person's username or e-mail were kept: they are security evidence, and they are deleted when the activity log's retention runs out."
msgstr[0] "Se ha conservado %d intento de acceso rechazado que escribió el usuario o el correo de esta persona: es una prueba de seguridad, y se borra cuando vence la retención del registro de actividad."
msgstr[1] "Se han conservado %d intentos de acceso rechazados que escribieron el usuario o el correo de esta persona: son pruebas de seguridad, y se borran cuando vence la retención del registro de actividad."

#. translators: %d: number of settings written
#, php-format
msgid "%d setting restored."
msgid_plural "%d settings restored."
msgstr[0] "Se restauró %d ajuste."
msgstr[1] "Se restauraron %d ajustes."

#. translators: %d: number of failing checks
#, php-format
msgid "%d thing needs attention."
msgid_plural "%d things need attention."
msgstr[0] "%d cosa necesita atención."
msgstr[1] "%d cosas necesitan atención."

#. translators: %d: how many times it can be changed
#, php-format
msgid "%d time"
msgid_plural "%d times"
msgstr[0] "%d vez"
msgstr[1] "%d veces"

#. translators: %s: how many sessions were closed at once.
#, php-format
msgid "%s closed"
msgstr "%s cerradas"

#. translators: %s: a number of days
#, php-format
msgid "%s day"
msgid_plural "%s days"
msgstr[0] "%s día"
msgstr[1] "%s días"

#. translators: %s: one or more placeholders, e.g. {link}
#, php-format
msgid "%s has to stay in whatever you write: without it the message is a dead end, so a save that lost it is refused."
msgstr "%s tiene que quedarse en lo que escribas: sin eso el mensaje no lleva a ninguna parte, así que un guardado que lo ha perdido se rechaza."

#. translators: %s: the ways in that are never behind a tab, comma separated
#, php-format
msgid "%s is not in this list and never goes behind a tab: it is the fastest way in there is, a tab would cost it a click, and inside one the browser never gets to offer it as the address field is focused."
msgstr "%s no está en esta lista y nunca va detrás de una pestaña: es la forma de entrar más rápida que hay, una pestaña le costaría un clic, y dentro de una el navegador nunca llega a ofrecerla porque el foco está en el campo de la dirección."

#. translators: %s: number of jobs
#, php-format
msgid "%s job is adding people in the background."
msgid_plural "%s jobs are adding people in the background."
msgstr[0] "%s tarea está añadiendo gente en segundo plano."
msgstr[1] "%s tareas están añadiendo gente en segundo plano."

#. translators: %s: number of sites
#, php-format
msgid "%s live site."
msgid_plural "%s live sites."
msgstr[0] "%s sitio activo."
msgstr[1] "%s sitios activos."

#. translators: %s: how many people have a session open
#, php-format
msgid "%s person has a session open."
msgid_plural "%s people have a session open."
msgstr[0] "%s persona tiene una sesión abierta."
msgstr[1] "%s personas tienen una sesión abierta."

#. translators: %s: number of sites
#, php-format
msgid "%s site on this network."
msgid_plural "%s sites on this network."
msgstr[0] "%s sitio en esta red."
msgstr[1] "%s sitios en esta red."

#. translators: %s: how many suggested fields are not on the list
#, php-format
msgid "%s suggested field is not on the list."
msgid_plural "%s suggested fields are not on the list."
msgstr[0] "%s campo sugerido no está en la lista."
msgstr[1] "%s campos sugeridos no están en la lista."

#. translators: %s: a percentage, already rounded
#, php-format
msgid "%s%%"
msgstr "%s%%"

#. translators: Accessibility text.
msgid "(opens in a new tab)"
msgstr "(se abre en una pestaña nueva)"

msgid "0 for what WordPress decides, 14 days. The sign-in link always counts as “remember me”: there is no password to type again."
msgstr "0 para lo que decida WordPress, 14 días. El enlace de acceso siempre cuenta como “recuérdame”: no hay contraseña que volver a escribir."

msgid "0 for what WordPress decides, 2 days. What somebody gets when they leave the box unticked on a form that offers it."
msgstr "0 para lo que decida WordPress, 2 días. Lo que recibe alguien que deja la casilla sin marcar en un formulario que la ofrece."

msgid "0 means whenever they like. A name that changes every day does not identify anybody, and the old address stops working each time."
msgstr "0 significa cuando quieran. Un nombre que cambia todos los días no identifica a nadie, y la dirección vieja deja de funcionar cada vez."

msgid "2FA"
msgstr "2FA"

msgid "A bar down the left"
msgstr "Una barra a la izquierda"

msgid "A border and the text in the accent, on the page’s own ground. For a design where a block of colour would be too loud."
msgstr "Un borde y el texto en el acento, sobre el fondo de la página. Para un diseño donde un bloque de color sería demasiado."

msgid "A box under Security in their account area, with one line per device. Unticked, the box is not there and closing a session stays an administrator’s job, from the report of open sessions."
msgstr "Un recuadro en Seguridad, dentro de su área de cuenta, con una línea por dispositivo. Sin marcar, el recuadro no está y cerrar una sesión sigue siendo tarea de quien administra, desde el informe de sesiones abiertas."

msgid "A brand new project needs no API enabled: sign-in works with the OAuth client alone. What does stop it is leaving the app in “Testing” and forgetting to add the person as a test user — they get “access blocked”."
msgstr "Un proyecto nuevo no necesita habilitar ninguna API: el acceso funciona solo con el cliente de OAuth. Lo que sí lo frena es dejar la aplicación en «Prueba» y olvidarse de añadir a la persona como usuario de prueba: le sale «acceso bloqueado»."

msgid "A button takes the colours the theme gives its own buttons, or yours."
msgstr "Un botón toma los colores que el tema les da a sus propios botones, o los tuyos."

msgid "A button to their details"
msgstr "Un botón a sus datos"

msgid "A centred card"
msgstr "Una tarjeta centrada"

msgid "A change in their security"
msgstr "Un cambio en su seguridad"

msgid "A class, as <code>.is-dark</code>, or an attribute, as <code>data-theme=\"dark\"</code>, or <code>data-mode</code> with any value."
msgstr "Una clase, como <code>.is-dark</code>, o un atributo, como <code>data-theme=\"dark\"</code>, o <code>data-mode</code> con cualquier valor."

msgid "A code by email"
msgstr "Un código por correo"

msgid "A code is on its way"
msgstr "Va de camino un código"

msgid "A code sent to the inbox the person has just opened to follow the link proves nothing the link did not prove already. An app does, so on an app it asks."
msgstr "Un código que llega a la misma bandeja que la persona acaba de abrir para seguir el enlace no prueba nada que el enlace no haya probado ya. Una aplicación sí, así que con una aplicación lo pide."

msgid "A colour of its own"
msgstr "Un color propio"

msgid "A colour of “Sign in” was not a colour, so it keeps the one it had."
msgstr "Un color de “Entrar” no era un color, así que queda el que tenía."

msgid "A current code, to confirm it is you"
msgstr "Un código vigente, para confirmar que eres tú"

#. translators: %s: provider name
#, php-format
msgid "A direct link to sign in with %s, if you want it somewhere else"
msgstr "Un enlace directo para entrar con %s, si lo quieres en otro sitio"

msgid "A door in the site’s own menu: “Sign in” for visitors, and for whoever is signed in their photo or their name, with their account, the dashboard if they can use it, and a way out underneath. The theme draws it like the rest of the menu."
msgstr "Una puerta en el propio menú del sitio: «Entrar» para quien visita, y para quien ha entrado, su foto o su nombre, con su cuenta, el escritorio si puede usarlo y una forma de salir debajo. El tema lo dibuja como el resto del menú."

msgid "A few questions many sites ask the people who register. None of them is asked until it is added here: tick the ones this site needs and they join the list, where each can be edited, made required, moved or deleted like any other field."
msgstr "Algunas preguntas que muchos sitios hacen a quien se registra. Ninguna se pregunta hasta que se añade aquí: marca las que este sitio necesita y pasan a la lista, donde cada una se puede editar, hacer obligatoria, mover o borrar como cualquier otro campo."

msgid "A few rows per person per day: this is the group that grows with how often people come back."
msgstr "Unas pocas filas por persona y día: este es el grupo que crece con la frecuencia con que la gente vuelve."

msgid "A field needs a name."
msgstr "El campo necesita un nombre."

msgid "A file with everything this site keeps about you: your details, and what the site and its plugins record about you. You get an email to confirm; once you do, we prepare it and it shows up here to download."
msgstr "Un archivo con todo lo que este sitio guarda sobre ti: tus datos, y lo que el sitio y sus plugins registran sobre ti. Te llega un correo para confirmar; cuando confirmas, lo preparamos y aparece aquí para descargar."

msgid "A filled button"
msgstr "Un botón relleno"

msgid "A filled button, a link, the section of the menu somebody is reading, and the initials drawn for anybody with no photo. Everything else — the grounds, the lines, the quiet text — the plugin builds around it. Each of these reads under white letters and as a link on white."
msgstr "Un botón relleno, un enlace, la sección del menú que alguien está leyendo y las iniciales que se dibujan para quien no tiene foto. Todo lo demás —los fondos, las líneas, el texto callado— el plugin lo construye alrededor. Cada uno de estos se lee bajo letras blancas y como enlace sobre blanco."

msgid "A form with every field on it, for whoever is signed in to fill in and save. Somebody who is not signed in sees nothing at all in its place."
msgstr "Un formulario con todos los campos, para que quien haya entrado lo rellene y lo guarde. Quien no haya entrado no ve absolutamente nada en su lugar."

#. translators: %s: e-mail address
#, php-format
msgid "A fresh code is on its way to %s."
msgstr "Va en camino un código nuevo a %s."

msgid "A fresh install records nothing, and has no table to record it in until a group is ticked here. Each one is ticked by whoever will be paying for the rows — which is why each one says roughly what it costs."
msgstr "Una instalación nueva no registra nada, y no tiene tabla donde registrarlo hasta que se marca un grupo aquí. Cada uno lo marca quien vaya a pagar por las filas: por eso cada uno dice más o menos lo que cuesta."

msgid "A grid with every section visible"
msgstr "Una cuadrícula con todas las secciones a la vista"

msgid "A line under the open section. Down the side it becomes a bar down the left, because a line under a stacked item runs across the whole menu."
msgstr "Una línea debajo de la sección abierta. En el lateral se convierte en una barra a la izquierda, porque una línea debajo de un elemento apilado cruza todo el menú."

msgid "A link e-mailed to the address on the account"
msgstr "Un enlace por correo a la dirección de la cuenta"

msgid "A link, like the rest of the menu"
msgstr "Un enlace, como el resto del menú"

msgid "A menu down the side"
msgstr "Un menú al costado"

#. translators: %s: the e-mail address of a new account
#, php-format
msgid "A new account, %s, on every site"
msgstr "Una cuenta nueva, %s, en todos los sitios"

msgid "A new password closes every session the account had open"
msgstr "Una contraseña nueva cierra todas las sesiones que la cuenta tenía abiertas"

msgid "A page of its own"
msgstr "Una página propia"

#. translators: %s: the address of the sign-in page
#, php-format
msgid "A page of its own, at %s."
msgstr "Una página propia, en %s."

msgid "A panel in the page, the way a settings screen looks. It sits quietly inside whatever the theme already draws."
msgstr "Un panel dentro de la página, como se ve una pantalla de ajustes. Se queda quieta dentro de lo que ya dibuja el tema."

msgid "A phone number of the wrong length"
msgstr "Un teléfono con un número de cifras incorrecto"

msgid "A registration form of the site’s own"
msgstr "Un formulario de registro propio del sitio"

msgid "A screen of its own at an address you choose, with your mark and colours and none of the theme’s header or footer. No page to create."
msgstr "Una pantalla propia en la dirección que elijas, con tu marca y tus colores y sin la cabecera ni el pie del tema. No hay que crear ninguna página."

msgid "A screen that comes back from a refused attempt ignores this and shows the way in that was refused, whatever it says here: a message about an address, read over a password form, explains nothing."
msgstr "Una pantalla que vuelve de un intento rechazado ignora esto y muestra la forma de entrar que fue rechazada, diga lo que diga aquí: un mensaje sobre una dirección, leído encima de un formulario de contraseña, no explica nada."

msgid "A second step is asked, as set on Security."
msgstr "Se pide un segundo paso, según lo configurado en Seguridad."

msgid "A secret is saved. Leave this empty to keep it, or paste a new one to replace it."
msgstr "Hay un secreto guardado. Deja esto vacío para conservarlo, o pega uno nuevo para reemplazarlo."

msgid "A session is what keeps somebody signed in after they close the tab. Here is how long one lasts on this site, and whether each person can see their own."
msgstr "Una sesión es lo que mantiene a alguien dentro después de cerrar la pestaña. Aquí está cuánto dura una en este sitio, y si cada persona puede ver las suyas."

msgid "A sign-in from a new device"
msgstr "Una entrada desde un dispositivo nuevo"

#. translators: %d: minutes
#, php-format
msgid "A single-use link, good for %d minutes."
msgstr "Un enlace de un solo uso, válido durante %d minutos."

msgid "A social account"
msgstr "Una red social"

msgid "A social account only signs in people who already have one here."
msgstr "Una cuenta social solo hace entrar a quien ya tiene una aquí."

msgid "A soft box in the colour of what it says"
msgstr "Una caja suave en el color de lo que dice"

msgid "A spacing of the menu was not a length in px or rem, so it keeps the one it had."
msgstr "Un espaciado del menú no era una medida en px o rem, así que queda el que tenía."

#. translators: %s: e-mail address
#, php-format
msgid "A test message is on its way to %s. If it does not arrive, nothing else will either."
msgstr "Va un mensaje de prueba a %s. Si no llega, tampoco llegará nada más."

msgid "A username and a password"
msgstr "Un nombre de usuario y una contraseña"

msgid "A web address cannot have spaces, so one of the two has to happen. The first is what almost everybody expects; the second is for a site that would rather nobody ends up with a name they did not type."
msgstr "Una dirección web no puede tener espacios, así que una de las dos cosas tiene que pasar. La primera es la que espera casi todo el mundo; la segunda es para un sitio que prefiere que nadie termine con un nombre que no escribió."

#. translators: %s: provider name
#, php-format
msgid "A window opens, %s asks you to authorise, and it comes back here. Nobody is signed in and nothing is saved to your account — it only checks that the round trip works. Until it does, the button cannot be enabled."
msgstr "Se abre una ventana, %s te pide autorizar, y vuelve aquí. No entra nadie ni se guarda nada en tu cuenta — solo comprueba que el ida y vuelta funciona. Hasta que funcione, el botón no se puede activar."

msgid "A word between square brackets, typed into a page. Nobody visiting the site ever sees the brackets: while the page is being drawn, WordPress swaps the line for the real thing — a form, a list, a set of buttons. Put it twice and the thing appears twice; delete the line and it is gone. Nothing else on the page is affected."
msgstr "Una palabra entre corchetes, escrita dentro de una página. Nadie que visite el sitio ve los corchetes: mientras se dibuja la página, WordPress cambia la línea por la cosa de verdad —un formulario, una lista, un juego de botones—. Ponla dos veces y la cosa aparece dos veces; borra la línea y desaparece. Nada más de la página se ve afectado."

msgid "About"
msgstr "Nosotros"

msgid "Above all of them, always"
msgstr "Por encima de todas, siempre"

msgid "Above and below"
msgstr "Arriba y abajo"

msgid "Accent"
msgstr "Acento"

msgid "Accent colour"
msgstr "Color de acento"

msgid "Access"
msgstr "Acceso"

msgid "Access › Summary →"
msgstr "Acceso › Resumen →"

msgid "Access › The sign-in page →"
msgstr "Acceso › La página de acceso →"

msgid "Access →"
msgstr "Acceso →"

msgid "Account area"
msgstr "Área de cuenta"

msgid "Account details and sign-in methods"
msgstr "Datos de la cuenta y formas de acceso"

msgid "Account linked."
msgstr "Cuenta vinculada."

msgid "Account page"
msgstr "Página de la cuenta"

msgid "Account sections"
msgstr "Secciones de la cuenta"

msgid "Accounts"
msgstr "Cuentas"

#. translators: %s: the ways an account gets created, comma separated
#, php-format
msgid "Accounts are created by: %s."
msgstr "Las cuentas las crea: %s."

#. translators: %s: the name of the site where the network's accounts live
#, php-format
msgid "Accounts are created on %s, for every site of the network. You come back here afterwards."
msgstr "Las cuentas se crean en %s, para todos los sitios de la red. Después vuelves aquí."

msgid "Accounts are made by whoever administers the site, under Users. Every door below is shut, WordPress’s own form on Settings → General included."
msgstr "Las cuentas las crea quien administra el sitio, en Usuarios. Todas las puertas de abajo están cerradas, incluido el formulario propio de WordPress en Ajustes → Generales."

msgid "Accounts made by the e-mail link or a social network were never asked for them. Once signed in, they are shown those fields alone on the account page, and then go on to where they were going. They can skip it, and are asked again at the next sign-in."
msgstr "A las cuentas creadas con el enlace por correo o con una red social nunca se les pidieron. Al entrar, ven solo esos campos en la página de cuenta y después siguen adonde iban. Se puede omitir, y se vuelve a pedir en la siguiente entrada."

msgid "Across the top, where the row begins, sits in the middle or ends. Down the side it is where the words in each line begin, which is the same question asked of a column."
msgstr "Arriba, donde empieza la fila, queda en el medio o termina. En el lateral es dónde empiezan las palabras de cada línea, que es la misma pregunta hecha a una columna."

msgid "Actions"
msgstr "Acciones"

msgid "Activate DiluxOne Users+ for the whole network"
msgstr "Activar DiluxOne Users+ para toda la red"

msgid "Active"
msgstr "Activa"

msgid "Active: it shows up in the forms"
msgstr "Activo: aparece en los formularios"

msgid "Activity"
msgstr "Actividad"

msgid "Activity log"
msgstr "Registro de actividad"

msgid "Add a block and pick the one called “Shortcode”. Typing “shortcode” into the block search finds it."
msgstr "Añade un bloque y elige el que se llama «Shortcode». Escribiendo «shortcode» en el buscador de bloques aparece."

msgid "Add a section"
msgstr "Añadir una sección"

msgid "Add field"
msgstr "Agregar campo"

msgid "Add one and from then on it opens this account too. Nothing gets duplicated: it is the same account with another way in."
msgstr "Sumá una y de ahí en más abre esta cuenta también. No se duplica nada: es la misma cuenta con otra forma de entrar."

msgid "Add suggested fields"
msgstr "Añadir campos sugeridos"

msgid "Add the ones ticked"
msgstr "Añadir los marcados"

msgid "Added by something else on this site"
msgstr "Lo ha añadido algo más de este sitio"

msgid "Adding everybody to every site has started. It goes on in the background, a batch at a time; its progress is below."
msgstr "Se empezó a añadir a todos en todos los sitios. Sigue en segundo plano, por tandas; su progreso está más abajo."

msgid "Additional details"
msgstr "Datos adicionales"

msgid "Address"
msgstr "Dirección"

msgid "After sign-in"
msgstr "Después de entrar"

msgid "After signing in, ask for the required fields the account has no answer for"
msgstr "Después de entrar, pedir los campos obligatorios que la cuenta no tiene rellenados"

msgid "After the door"
msgstr "Después de la puerta"

msgid "After the link is sent"
msgstr "Después de enviar el enlace"

msgid "After what the plugin shows"
msgstr "Después de lo que muestra el plugin"

msgid "All the doors"
msgstr "Todas las puertas"

msgid "Almost nothing, and it is the group worth having when an account is taken over."
msgstr "Casi nada, y es el grupo que merece la pena tener cuando le roban una cuenta a alguien."

msgid "Almost nothing: most people change these once and never again."
msgstr "Casi nada: la mayoría cambia esto una vez y nunca más."

msgid "Already have an account?"
msgstr "¿Ya tienes una cuenta?"

msgid "Always ask"
msgstr "Pedirlo siempre"

msgid "Always in tabs"
msgstr "Siempre en pestañas"

msgid "Always sent"
msgstr "Se envía siempre"

msgid "Always sent — no switch for anybody"
msgstr "Se envía siempre: sin interruptor para nadie"

msgid "Always stacked"
msgstr "Siempre apiladas"

msgid "An account belongs to the whole network; being a member of a site — having a role on it — is each site’s. This decides which sites an account is a member of, for every site of the network."
msgstr "Una cuenta pertenece a toda la red; ser miembro de un sitio —tener un rol en él— es cosa de cada sitio. Esto decide de qué sitios es miembro una cuenta, para todos los sitios de la red."

msgid "An account with admin permissions cannot ask for its own deletion."
msgstr "Una cuenta con permisos de administración no puede pedir que la borren."

msgid "An authenticator app"
msgstr "Una aplicación autenticadora"

msgid "An icon inside the buttons of the doors: an envelope on the link"
msgstr "Un icono dentro de los botones de las puertas: un sobre en el enlace"

msgid "An outlined button"
msgstr "Un botón con borde"

msgid "And again"
msgstr "Y otra vez"

msgid "And the note under it"
msgstr "Y la nota de debajo"

msgid "And then, here"
msgstr "Y después, aquí"

msgid "Any code you can get for the second step: one of your backup codes, or the one we email you."
msgstr "Cualquier código que tengas para el segundo paso: uno de tus códigos de respaldo o el que te enviamos por correo."

msgid "Any colour"
msgstr "Cualquier color"

msgid "Any of these opens this same account. Unlink the ones you do not use."
msgstr "Cualquiera de estas abre esta misma cuenta. Desvincula las que no uses."

#. translators: %s: the account page, as a link
#, php-format
msgid "Anybody sent to their account lands on %s."
msgstr "Quien es enviado a su cuenta aterriza en %s."

msgid "Anybody who can reach the dashboard edits their details there as well as on the site."
msgstr "Quien pueda llegar al escritorio edita sus datos ahí además de en el sitio."

msgid "Anything older goes once a day, on its own. 0 keeps everything for ever, which is a real answer for a site that has to keep it — and the one that has no end."
msgstr "Lo más antiguo que eso se borra una vez al día, solo. Con 0 se guarda todo para siempre, que es una respuesta real para un sitio que tiene que guardarlo, y la única que no tiene fin."

msgid "Anything that happened"
msgstr "Cualquier cosa que haya pasado"

msgid "Anything the plugin does not know about is left exactly as it is typed, and one it knows but has nothing to put in comes out as nothing at all."
msgstr "Lo que el plugin no conoce se queda tal cual se escribió, y lo que conoce pero no tiene con qué rellenar sale como nada."

msgid "Apple signs its client secret with a JWT that has to be regenerated every six months and answers by POST; Steam does not use OAuth 2 at all and never returns an email address. Both need their own flow, so they are not here yet: a button that does not work is worse than no button."
msgstr "Apple firma su secreto de cliente con un JWT que hay que regenerar cada seis meses y responde por POST; Steam directamente no usa OAuth 2 y nunca devuelve el correo. Los dos necesitan su propio flujo, así que todavía no están: un botón que no anda es peor que no tener el botón."

msgid "Application type: “Web application”. Give it a name — this one is only for you."
msgstr "Tipo de aplicación: «Aplicación web». Ponle un nombre: ese es solo para ti."

