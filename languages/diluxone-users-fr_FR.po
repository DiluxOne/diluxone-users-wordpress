msgstr "La table contient %1$s lignes et occupe %2$s."

#: includes/admin-log.php:189
msgid "a size this database will not report"
msgstr "une taille que cette base de données ne communique pas"

#. translators: %s: a date.
#: includes/admin-log.php:195
#, php-format
msgid "The oldest row is from %s."
msgstr "La ligne la plus ancienne date du %s."

#: includes/admin-log.php:204
msgid "kept for ever"
msgstr "conservé pour toujours"

#. translators: %s: a number of days.
#: includes/admin-log.php:207
#, php-format
