#. translators: 1: sections shown, 2: sections there are
#, php-format
msgid "%1$d of %2$d shown."
msgstr "%1$d sur %2$d affichés."

#. translators: 1: how long ago, 2: device and browser, 3: IP address
#, php-format
msgid "%1$s ago, from %2$s (%3$s)"
msgstr "il y a %1$s, depuis %2$s (%3$s)"

#. translators: 1: the address, 2: what else is there
#, php-format
msgid "%1$s is also %2$s, which nobody can reach while the sign-in page answers there."
msgstr "%1$s est aussi l’adresse de %2$s, que personne ne peut atteindre tant que la page de connexion y répond."

#. translators: 1: how many people, 2: how many accounts in total
#, php-format
msgid "%1$s of %2$s"
msgstr "%1$s sur %2$s"

#. translators: 1: number of people, 2: current page, 3: total pages
#, php-format
msgid "%1$s people with an open session · page %2$d of %3$d"
msgstr "%1$s personnes avec une session ouverte · page %2$d sur %3$d"

#. translators: 1: number of rows, 2: current page, 3: total pages
#, php-format
msgid "%1$s rows · page %2$d of %3$d"
msgstr "%1$s lignes · page %2$d sur %3$d"

#. translators: 1: how long with "remember me" (a number of days, or what WordPress decides), 2: the same without it
#, php-format
msgid "%1$s with “remember me”, %2$s without. The e-mail link always counts as “remember me”."
msgstr "%1$s avec « Se souvenir de moi », %2$s sans. Le lien par e-mail compte toujours comme « Se souvenir de moi »."

#. translators: 1: plugin name, 2: screen name
#, php-format
msgctxt "title of a dashboard screen"
msgid "%1$s | %2$s"
msgstr "%1$s | %2$s"

#. translators: 1: percentage done, 2: additions looked at, 3: additions in all
#, php-format
msgid "%1$s%% (%2$s of %3$s)"
msgstr "%1$s %% (%2$s sur %3$s)"

#. translators: 1: provider name, 2: how it stands, in a sentence
#, php-format
msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

#. translators: %d: number of providers
#, php-format
msgid "%d provider configured and enabled."
msgid_plural "%d providers configured and enabled."
msgstr[0] "%d fournisseur configuré et activé."
msgstr[1] "%d fournisseurs configurés et activés."

#. translators: %d: how many refused sign-in attempts are kept.
#, php-format
msgid "%d refused sign-in attempt that typed this person's username or e-mail was kept: it is security evidence, and it is deleted when the activity log's retention runs out."
msgid_plural "%d refused sign-in attempts that typed this person's username or e-mail were kept: they are security evidence, and they are deleted when the activity log's retention runs out."
msgstr[0] "%d tentative de connexion refusée qui a saisi l’identifiant ou l’e-mail de cette personne a été conservée : c’est une preuve de sécurité, supprimée quand la durée de conservation du journal d’activité est atteinte."
msgstr[1] "%d tentatives de connexion refusées qui ont saisi l’identifiant ou l’e-mail de cette personne ont été conservées : ce sont des preuves de sécurité, supprimées quand la durée de conservation du journal d’activité est atteinte."

#. translators: %d: number of settings written
#, php-format
msgid "%d setting restored."
msgid_plural "%d settings restored."
msgstr[0] "%d réglage restauré."
msgstr[1] "%d réglages restaurés."

#. translators: %d: number of failing checks
#, php-format
msgid "%d thing needs attention."
msgid_plural "%d things need attention."
msgstr[0] "%d chose demande votre attention."
msgstr[1] "%d choses demandent votre attention."

#. translators: %d: how many times it can be changed
#, php-format
msgid "%d time"
msgid_plural "%d times"
msgstr[0] "%d fois"
msgstr[1] "%d fois"

#. translators: %s: how many sessions were closed at once.
#, php-format
msgid "%s closed"
msgstr "%s fermées"

#. translators: %s: a number of days
#, php-format
msgid "%s day"
msgid_plural "%s days"
msgstr[0] "%s jour"
msgstr[1] "%s jours"

#. translators: %s: one or more placeholders, e.g. {link}
#, php-format
msgid "%s has to stay in whatever you write: without it the message is a dead end, so a save that lost it is refused."
msgstr "%s doit rester dans ce que vous écrivez : sans lui le message est une impasse, donc un enregistrement qui l’a perdu est refusé."

#. translators: %s: the ways in that are never behind a tab, comma separated
#, php-format
msgid "%s is not in this list and never goes behind a tab: it is the fastest way in there is, a tab would cost it a click, and inside one the browser never gets to offer it as the address field is focused."
msgstr "%s ne figure pas dans cette liste et ne passe jamais derrière un onglet : c’est la façon d’entrer la plus rapide qui soit, un onglet lui coûterait un clic, et à l’intérieur d’un onglet le navigateur n’a jamais l’occasion de la proposer puisque le champ de l’adresse a le focus."

#. translators: %s: number of jobs
#, php-format
msgid "%s job is adding people in the background."
msgid_plural "%s jobs are adding people in the background."
msgstr[0] "%s tâche ajoute des personnes en arrière-plan."
msgstr[1] "%s tâches ajoutent des personnes en arrière-plan."

#. translators: %s: number of sites
#, php-format
msgid "%s live site."
msgid_plural "%s live sites."
msgstr[0] "%s site actif."
msgstr[1] "%s sites actifs."

#. translators: %s: how many people have a session open
#, php-format
msgid "%s person has a session open."
msgid_plural "%s people have a session open."
msgstr[0] "%s personne a une session ouverte."
msgstr[1] "%s personnes ont une session ouverte."

#. translators: %s: number of sites
#, php-format
msgid "%s site on this network."
msgid_plural "%s sites on this network."
msgstr[0] "%s site sur ce réseau."
msgstr[1] "%s sites sur ce réseau."

#. translators: %s: how many suggested fields are not on the list
#, php-format
msgid "%s suggested field is not on the list."
msgid_plural "%s suggested fields are not on the list."
msgstr[0] "%s champ suggéré n’est pas dans la liste."
msgstr[1] "%s champs suggérés ne sont pas dans la liste."

#. translators: %s: a percentage, already rounded
#, php-format
msgid "%s%%"
msgstr "%s %%"

#. translators: %s: a role's name
#, php-format
msgid "%s, whichever door they came through."
msgstr "%s, quelle que soit la porte par laquelle la personne est arrivée."

#. translators: Accessibility text.
msgid "(opens in a new tab)"
msgstr "(s’ouvre dans un nouvel onglet)"

msgid "0 for what WordPress decides, 14 days. The sign-in link always counts as “remember me”: there is no password to type again."
msgstr "0 pour ce que décide WordPress, 14 jours. Le lien de connexion compte toujours comme « Se souvenir de moi » : il n’y a pas de mot de passe à retaper."

msgid "0 for what WordPress decides, 2 days. What somebody gets when they leave the box unticked on a form that offers it."
msgstr "0 pour ce que décide WordPress, 2 jours. Ce qu’obtient quelqu’un qui laisse la case décochée sur un formulaire qui la propose."

msgid "2FA"
msgstr "2FA"

msgid "A bar down the left"
msgstr "Une barre à gauche"

msgid "A bit more about you"
msgstr "Un peu plus sur vous"

msgid "A border and the text in the accent, on the page’s own ground. For a design where a block of colour would be too loud."
msgstr "Un contour et le texte en couleur d’accent, sur le fond de la page. Pour un design où un bloc de couleur serait trop fort."

msgid "A box under Security in their account area, with one line per device. Unticked, the box is not there and closing a session stays an administrator’s job, from the report of open sessions."
msgstr "Un encadré sous Sécurité dans son espace de compte, avec une ligne par appareil. Non coché, l’encadré n’est pas là et fermer une session reste le travail de qui administre, depuis le rapport des sessions ouvertes."

msgid "A brand new project needs no API enabled: sign-in works with the OAuth client alone. What does stop it is leaving the app in “Testing” and forgetting to add the person as a test user — they get “access blocked”."
msgstr "Un projet tout neuf n’a besoin d’activer aucune API : la connexion fonctionne avec le seul client OAuth. Ce qui bloque vraiment, c’est de laisser l’application en « Test » et d’oublier d’ajouter la personne comme utilisateur test : elle obtient « accès bloqué »."

msgid "A button takes the colours the theme gives its own buttons, or yours."
msgstr "Un bouton prend les couleurs que le thème donne à ses propres boutons, ou les vôtres."

msgid "A button to their details"
msgstr "Un bouton vers ses informations"

msgid "A centred card"
msgstr "Une carte centrée"

msgid "A change in their security"
msgstr "Un changement dans sa sécurité"

msgid "A class, as <code>.is-dark</code>, or an attribute, as <code>data-theme=\"dark\"</code>, or <code>data-mode</code> with any value."
msgstr "Une classe, comme <code>.is-dark</code>, ou un attribut, comme <code>data-theme=\"dark\"</code>, ou <code>data-mode</code> avec n’importe quelle valeur."

msgid "A code by email"
msgstr "Un code par e-mail"

msgid "A code is on its way"
msgstr "Un code est en route"

msgid "A colour of its own"
msgstr "Une couleur à elle"

msgid "A colour of “Sign in” was not a colour, so it keeps the one it had."
msgstr "Une couleur de « Se connecter » n’était pas une couleur : il garde celle qu’il avait."

msgid "A current code, to confirm it is you"
msgstr "Un code en cours de validité, pour confirmer que c’est bien vous"

#. translators: %s: provider name
#, php-format
msgid "A direct link to sign in with %s, if you want it somewhere else"
msgstr "Un lien direct pour se connecter avec %s, si vous le voulez ailleurs"

msgid "A door in the site’s own menu: “Sign in” for visitors, and for whoever is signed in their photo or their name, with their account, the dashboard if they can use it, and a way out underneath. The theme draws it like the rest of the menu."
msgstr "Une porte dans le menu du site : « Se connecter » pour les visiteurs, et pour qui est connecté, sa photo ou son nom, avec son compte, le tableau de bord s’il peut l’utiliser et un moyen de sortir en dessous. Le thème le dessine comme le reste du menu."

msgid "A few questions many sites ask the people who register. None of them is asked until it is added here: tick the ones this site needs and they join the list, where each can be edited, made required, moved or deleted like any other field."
msgstr "Quelques questions que beaucoup de sites posent aux personnes qui s’inscrivent. Aucune n’est posée avant d’être ajoutée ici : cochez celles dont ce site a besoin et elles rejoignent la liste, où chacune peut être modifiée, rendue obligatoire, déplacée ou supprimée comme n’importe quel autre champ."

msgid "A few rows per person per day: this is the group that grows with how often people come back."
msgstr "Quelques lignes par personne et par jour : c’est le groupe qui grandit avec la fréquence des retours."

msgid "A field needs a name."
msgstr "Un champ a besoin d’un nom."

msgid "A file with everything this site keeps about you: your details, and what the site and its plugins record about you. You get an email to confirm; once you do, we prepare it and it shows up here to download."
msgstr "Un fichier avec tout ce que ce site conserve sur vous : vos informations, et ce que le site et ses extensions enregistrent sur vous. Vous recevez un e-mail pour confirmer ; une fois confirmé, nous le préparons et il apparaît ici pour le télécharger."

msgid "A filled button"
msgstr "Un bouton plein"

msgid "A filled button, a link, the section of the menu somebody is reading, and the initials drawn for anybody with no photo. Everything else — the grounds, the lines, the quiet text — the plugin builds around it. Each of these reads under white letters and as a link on white."
msgstr "Un bouton plein, un lien, la section du menu que l’on est en train de lire et les initiales dessinées pour qui n’a pas de photo. Tout le reste — les fonds, les lignes, le texte discret — l’extension le construit autour. Chacune de ces couleurs se lit sous des lettres blanches et comme lien sur du blanc."

msgid "A form with every field on it, for whoever is signed in to fill in and save. Somebody who is not signed in sees nothing at all in its place."
msgstr "Un formulaire avec tous les champs, que la personne connectée remplit et enregistre. Qui n’est pas connecté ne voit absolument rien à sa place."

#. translators: %s: e-mail address
#, php-format
msgid "A fresh code is on its way to %s."
msgstr "Un nouveau code est en route vers %s."

msgid "A fresh install records nothing, and has no table to record it in until a group is ticked here. Each one is ticked by whoever will be paying for the rows — which is why each one says roughly what it costs."
msgstr "Une nouvelle installation n’enregistre rien, et n’a pas de table où l’enregistrer tant qu’aucun groupe n’est coché ici. Chacun est coché par celui qui paiera les lignes — c’est pourquoi chacun dit à peu près ce qu’il coûte."

msgid "A grid with every section visible"
msgstr "Une grille où toutes les sections sont visibles"

msgid "A line under the open section. Down the side it becomes a bar down the left, because a line under a stacked item runs across the whole menu."
msgstr "Un trait sous la section ouverte. Sur le côté, il devient une barre à gauche, car un trait sous un élément empilé traverse tout le menu."

msgid "A link e-mailed to the address on the account"
msgstr "Un lien envoyé par e-mail à l’adresse du compte"

msgid "A link lets in only somebody who already has an account."
msgstr "Un lien ne laisse entrer que quelqu’un qui a déjà un compte."

msgid "A link, like the rest of the menu"
msgstr "Un lien, comme le reste du menu"

msgid "A menu down the side"
msgstr "Un menu sur le côté"

#. translators: %s: the e-mail address of a new account
#, php-format
msgid "A new account, %s, on every site"
msgstr "Un nouveau compte, %s, sur chaque site"

msgid "A new password signs the account out on every other device, as WordPress does, and the list forgets them."
msgstr "Un nouveau mot de passe déconnecte le compte sur tous les autres appareils, comme le fait WordPress, et la liste les oublie."

msgid "A page of its own"
msgstr "Une page à part"

#. translators: %s: the address of the sign-in page
#, php-format
msgid "A page of its own, at %s."
msgstr "Une page à part, sur %s."

msgid "A panel in the page, the way a settings screen looks. It sits quietly inside whatever the theme already draws."
msgstr "Un panneau dans la page, comme un écran de réglages. Il reste tranquille à l'intérieur de ce que le thème dessine déjà."

msgid "A phone number of the wrong length"
msgstr "Un numéro de téléphone de la mauvaise longueur"

msgid "A registration form of the site’s own"
msgstr "Un formulaire d’inscription propre au site"

msgid "A screen of its own at an address you choose, with your mark and colours and none of the theme’s header or footer. No page to create."
msgstr "Un écran à part, à l’adresse de votre choix, avec votre logo et vos couleurs et sans l’en-tête ni le pied de page du thème. Aucune page à créer."

msgid "A screen that comes back from a refused attempt ignores this and shows the way in that was refused, whatever it says here: a message about an address, read over a password form, explains nothing."
msgstr "Un écran qui revient d’une tentative refusée ignore ceci et affiche la façon d’entrer qui a été refusée, quoi qu’il soit dit ici : un message au sujet d’une adresse, lu au-dessus d’un formulaire de mot de passe, n’explique rien."

msgid "A second step is asked, as set on Security."
msgstr "Une deuxième étape est demandée, comme réglé dans Sécurité."

msgid "A secret is saved. Leave this empty to keep it, or paste a new one to replace it."
msgstr "Un secret est enregistré. Laissez ce champ vide pour le conserver, ou collez-en un nouveau pour le remplacer."

msgid "A session is what keeps somebody signed in after they close the tab. Here is how long one lasts on this site, and whether each person can see their own."
msgstr "Une session, c’est ce qui garde quelqu’un connecté après la fermeture de l’onglet. Voici combien de temps elle dure sur ce site, et si chaque personne peut voir les siennes."

msgid "A sign-in from a new device"
msgstr "Une connexion depuis un nouvel appareil"

#. translators: %d: minutes
#, php-format
msgid "A single-use link, good for %d minutes."
msgstr "Un lien à usage unique, valable %d minutes."

msgid "A social account"
msgstr "Un compte social"

msgid "A social account lets in only somebody who already has one here."
msgstr "Un compte social ne laisse entrer que quelqu’un qui en a déjà un ici."

msgid "A social account only signs in people who already have one here."
msgstr "Un compte social ne connecte que les gens qui en ont déjà un ici."

msgid "A soft box in the colour of what it says"
msgstr "Un bloc doux dans la couleur de ce qu’il dit"

msgid "A spacing of the menu was not a length in px or rem, so it keeps the one it had."
msgstr "Un espacement du menu n’était pas une longueur en px ou en rem : il garde celui qu’il avait."

#. translators: %s: e-mail address
#, php-format
msgid "A test message is on its way to %s. If it does not arrive, nothing else will either."
msgstr "Un message de test part vers %s. S’il n’arrive pas, rien d’autre n’arrivera non plus."

msgid "A username and a password"
msgstr "Un identifiant et un mot de passe"

msgid "A web address cannot have spaces, so one of the two has to happen. The first is what almost everybody expects; the second is for a site that would rather nobody ends up with a name they did not type."
msgstr "Une adresse web ne peut pas contenir d’espaces : l’une des deux choses doit donc arriver. La première est ce que presque tout le monde attend ; la seconde est pour un site qui préfère que personne ne se retrouve avec un nom qu’il n’a pas tapé."

#. translators: %s: provider name
#, php-format
msgid "A window opens, %s asks you to authorise, and it comes back here. Nobody is signed in and nothing is saved to your account — it only checks that the round trip works. Until it does, the button cannot be enabled."
msgstr "Une fenêtre s’ouvre, %s vous demande d’autoriser, et cela revient ici. Personne n’est connecté et rien n’est enregistré sur votre compte — cela vérifie seulement que l’aller-retour fonctionne. Tant que ce n’est pas le cas, le bouton ne peut pas être activé."

msgid "A word between square brackets, typed into a page. Nobody visiting the site ever sees the brackets: while the page is being drawn, WordPress swaps the line for the real thing — a form, a list, a set of buttons. Put it twice and the thing appears twice; delete the line and it is gone. Nothing else on the page is affected."
msgstr "Un mot entre crochets, tapé dans une page. Aucun visiteur du site ne voit les crochets : pendant que la page se dessine, WordPress remplace la ligne par la chose elle-même — un formulaire, une liste, une série de boutons. Mettez-la deux fois et la chose apparaît deux fois ; supprimez la ligne et elle disparaît. Rien d’autre sur la page n’est touché."

msgid "About"
msgstr "À propos"

msgid "About you"
msgstr "À propos de vous"

msgid "Above all of them, always"
msgstr "Au-dessus de toutes, toujours"

msgid "Above and below"
msgstr "Au-dessus et en dessous"

msgid "Accent"
msgstr "Accent"

msgid "Accent colour"
msgstr "Couleur d’accent"

msgid "Access"
msgstr "Accès"

msgid "Access › Summary →"
msgstr "Accès › Résumé →"

msgid "Access › The sign-in page →"
msgstr "Accès › La page de connexion →"

msgid "Access →"
msgstr "Accès →"

msgid "Account area"
msgstr "Espace compte"

msgid "Account details and sign-in methods"
msgstr "Informations du compte et moyens de connexion"

msgid "Account linked."
msgstr "Compte lié."

msgid "Account page"
msgstr "Page du compte"

msgid "Account sections"
msgstr "Sections du compte"

msgid "Accounts"
msgstr "Comptes"

#. translators: %s: the name of the site where the network's accounts live
#, php-format
msgid "Accounts are created on %s, for every site of the network. You come back here afterwards."
msgstr "Les comptes se créent sur %s, pour tous les sites du réseau. Vous revenez ici ensuite."

msgid "Accounts are made by whoever administers the site, under Users. Every door below is shut, WordPress’s own form on Settings → General included."
msgstr "Les comptes sont créés par la personne qui administre le site, sous Utilisateurs. Toutes les portes ci-dessous sont fermées, y compris le formulaire propre à WordPress dans Réglages → Général."

msgid "Across the top, where the row begins, sits in the middle or ends. Down the side it is where the words in each line begin, which is the same question asked of a column."
msgstr "En haut, là où la rangée commence, se tient au milieu ou se termine. Sur le côté, c’est là où commencent les mots de chaque ligne, la même question posée à une colonne."

msgid "Actions"
msgstr "Actions"

msgid "Activate DiluxOne Users+ for the whole network"
msgstr "Activer DiluxOne Users+ pour tout le réseau"

msgid "Active"
msgstr "Actif"

msgid "Active: it shows up in the forms"
msgstr "Actif : il apparaît dans les formulaires"

msgid "Activity"
msgstr "Activité"

msgid "Activity log"
msgstr "Journal d’activité"

msgid "Add a block and pick the one called “Shortcode”. Typing “shortcode” into the block search finds it."
msgstr "Ajoutez un bloc et choisissez celui qui s’appelle « Code court ». En tapant « code court » dans la recherche de blocs, vous le trouverez."

msgid "Add a section"
msgstr "Ajouter une section"

msgid "Add field"
msgstr "Ajouter un champ"

msgid "Add one and from then on it opens this account too. Nothing gets duplicated: it is the same account with another way in."
msgstr "Ajoutez-en un et à partir de là il ouvre aussi ce compte. Rien n’est dupliqué : c’est le même compte avec une autre façon d’entrer."

msgid "Add suggested fields"
msgstr "Ajouter des champs suggérés"

msgid "Add the ones ticked"
msgstr "Ajouter ceux qui sont cochés"

msgid "Added by something else on this site"
msgstr "Ajouté par autre chose sur ce site"

msgid "Adding everybody to every site has started. It goes on in the background, a batch at a time; its progress is below."
msgstr "L’ajout de tout le monde à chaque site a commencé. Il se poursuit en arrière-plan, lot après lot ; sa progression est ci-dessous."

msgid "Additional details"
msgstr "Informations complémentaires"

msgid "Address"
msgstr "Adresse"

msgid "Afghanistan"
msgstr "Afghanistan"

msgid "After sign-in"
msgstr "Après la connexion"

msgid "After signing in, ask for the required fields the account has no answer for"
msgstr "Après la connexion, demander les champs obligatoires auxquels le compte n’a pas répondu"

msgid "After signing in, people go straight to where they were going, whatever their account is missing."
msgstr "Après la connexion, les gens vont directement là où ils allaient, quoi qu’il manque à leur compte."

msgid "After the door"
msgstr "Après la porte"

msgid "After the link is sent"
msgstr "Une fois le lien envoyé"

msgid "After what the plugin shows"
msgstr "Après ce que l’extension affiche"

msgid "Aland Islands"
msgstr "Îles Åland"

msgid "Albania"
msgstr "Albanie"

msgid "Algeria"
msgstr "Algérie"

msgid "All the doors"
msgstr "Toutes les portes"

msgid "Almost nothing, and it is the group worth having when an account is taken over."
msgstr "Presque rien, et c’est le groupe qu’on est content d’avoir quand un compte est détourné."

msgid "Almost nothing: most people change these once and never again."
msgstr "Presque rien : la plupart des gens changent cela une fois et plus jamais."

msgid "Already have an account?"
msgstr "Vous avez déjà un compte ?"

msgid "Always in tabs"
msgstr "Toujours en onglets"

msgid "Always sent"
msgstr "Toujours envoyé"

msgid "Always sent — no switch for anybody"
msgstr "Toujours envoyé — pas d’interrupteur pour personne"

msgid "Always stacked"
msgstr "Toujours empilées"

msgid "American Samoa"
msgstr "Samoa américaines"

msgid "An account belongs to the whole network; being a member of a site — having a role on it — is each site’s. This decides which sites an account is a member of, for every site of the network."
msgstr "Un compte appartient à tout le réseau ; être membre d’un site — y avoir un rôle — relève de chaque site. Ceci décide de quels sites un compte est membre, pour chaque site du réseau."

msgid "An account with admin permissions cannot ask for its own deletion."
msgstr "Un compte avec des permissions d’administration ne peut pas demander sa propre suppression."

msgid "An address the site has never seen gets a link, and the account exists by the time they are in."
msgstr "Une adresse que le site n’a jamais vue reçoit un lien, et le compte existe au moment où la personne entre."

msgid "An authenticator app"
msgstr "Une application d’authentification"

msgid "An icon inside the buttons of the doors: an envelope on the link"
msgstr "Une icône dans les boutons des portes : une enveloppe sur le lien"

msgid "An outlined button"
msgstr "Un bouton à contour"

msgid "And again"
msgstr "Et encore une fois"

msgid "And the note under it"
msgstr "Et la note en dessous"

msgid "And then, here"
msgstr "Et ensuite, ici"

msgid "Andorra"
msgstr "Andorre"

msgid "Angola"
msgstr "Angola"

msgid "Anguilla"
msgstr "Anguilla"

msgid "Antarctica"
msgstr "Antarctique"

msgid "Antigua and Barbuda"
msgstr "Antigua-et-Barbuda"

msgid "Any code you can get for the second step: one of your backup codes, or the one we email you."
