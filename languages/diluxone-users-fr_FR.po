#: includes/admin-login.php:473
#, php-format
msgid "Not used while the shape of the sign-in page is “A page of its own”: people sign in at %s, and a page chosen here sends them there."
msgstr "Inutilisée tant que la forme de la page de connexion est « Une page à part » : on se connecte sur %s, et une page choisie ici y renvoie."

#: includes/admin-login.php:477
msgid "Design › The sign-in page →"
msgstr "Design › La page de connexion →"

#: includes/admin-login.php:1137
msgid "A page of its own"
msgstr "Une page à part"

#: includes/admin-login.php:1138
msgid "A screen of its own at an address you choose, with your mark and colours and none of the theme’s header or footer. No page to create."
msgstr "Un écran à part, à l’adresse de votre choix, avec votre logo et vos couleurs et sans l’en-tête ni le pied de page du thème. Aucune page à créer."

#: includes/admin-login.php:1278
msgid "Used when the shape is “A page of its own”."
msgstr "Utilisée quand la forme est « Une page à part »."

#: includes/admin-login.php:1283
msgid "Its address"
msgstr "Son adresse"

#. translators: %s: the address of the registration form on the sign-in page of its own
#: includes/admin-register.php:309
#, php-format
msgid "Not used while the shape of the sign-in page is “A page of its own”: the form is at %s, and a page chosen here sends people there."
msgstr "Inutilisée tant que la forme de la page de connexion est « Une page à part » : le formulaire est sur %s, et une page choisie ici y renvoie."

#. translators: 1: the address, 2: what else is there
#: includes/admin-status.php:209
#, php-format
msgid "%1$s is also %2$s, which nobody can reach while the sign-in page answers there."
msgstr "%1$s est aussi l’adresse de %2$s, que personne ne peut atteindre tant que la page de connexion y répond."

#: includes/admin-status.php:213
msgid "Its address is taken."
msgstr "Son adresse est déjà prise."

#: includes/admin-status.php:215
