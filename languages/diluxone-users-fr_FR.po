#: includes/admin-log.php:377
#, php-format
msgid "%1$s rows · page %2$d of %3$d"
msgstr "%1$s lignes · page %2$d sur %3$d"

#: includes/admin-log.php:402
#: includes/log-privacy.php:68
msgid "When"
msgstr "Quand"

#: includes/admin-log.php:405
msgid "Detail"
msgstr "Détail"

#: includes/admin-log.php:412
