<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
    bootstrap="tests/bootstrap-integration.php"
    colors="true"
    convertErrorsToExceptions="true"
    convertNoticesToExceptions="true"
    convertWarningsToExceptions="true"
    convertDeprecationsToExceptions="true"
    failOnRisky="true"
    cacheResultFile=".phpunit.result.cache.integration"
    beStrictAboutOutputDuringTests="false"
    beStrictAboutTestsThatDoNotTestAnything="true"
    executionOrder="default"
>
    <testsuites>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <!--
        Coverage (`make coverage-integration`) counts what the suite runs and
        nothing else: a file no test loaded is added by
        tests/coverage/report.php, at 0%, after the parts are merged. Adding it
        here as well would add PHP-Parser's idea of its lines to the merge,
        which is not always PCOV's, and leave lines no driver can ever see as
        "never run".
    -->
    <coverage includeUncoveredFiles="false" processUncoveredFiles="false">
        <include>
            <directory suffix=".php">includes</directory>
            <directory suffix=".php">templates</directory>
        </include>
    </coverage>

    <!--
        Notices, warnings and deprecations are failures here, as in the unit
        suite: a warning in the plugin's code is a bug a site's debug.log would
        fill with, and the suite is where it is cheapest to see. What WordPress
        itself raises because a test skipped part of a real request (a hook
        that reads the current screen, say) is fixed in the test, by giving it
        what the request would have had.

        beStrictAboutOutputDuringTests is off because integration tests
        legitimately exercise wp_send_json and similar functions that produce
        output as part of their normal flow.
    -->
</phpunit>
