{
  "name": "diluxone-users-dev",
  "private": true,
  "description": "Local development environment scripts for the DiluxOne Users+ WordPress plugin. Not published to npm — only used to pin @wordpress/env and the end-to-end runner for contributors.",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/soydiloreto/diluxone-users-wordpress.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy",
    "env:reset": "wp-env destroy && wp-env start",
    "env:cli": "wp-env run cli",
    "env:logs": "wp-env logs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:network": "playwright test -c playwright.network.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@wordpress/env": "^11.15.0"
  }
}
